  "usage_in_t220_review_ui": {
    "description": "How to use benchmark library in T-220 Review UI for customer process setup",
    "load_benchmark_defaults": {
      "code_example": `
// When setting up downtime cost for customer process
const loadBenchmarkDefaults = async (payerSize, processType) => {
  const response = await fetch(
    \`/api/benchmarks/by-payer-size?size=\${payerSize}\`
  );
  const benchmark = await response.json();

  return benchmark.crown_jewel_downtime_cost[processType];
};

// Example: Medium payer, Claims Adjudication
const defaults = await loadBenchmarkDefaults('medium', 'claims_adjudication');
// Returns: { estimated_value: 1800000, range: { low: 750000, high: 7500000 }, ... }

// User can adjust based on actual volume
const adjusted = {
  ...defaults,
  assumptions: [
    ...defaults.assumptions,
    {
      assumption: "Customer actual volume: 15,000 claims/day",
      source: "Customer implementation data",
      confidence: 0.95
    }
  ],
  calculation: "15,000 claims/day × $150/claim = $2,250,000/day",
  estimated_value: 2250000
};
      `,
      "notes": "Benchmark provides conversation starter. User adjusts based on actual customer data."
    },
    "benchmark_selection_flow": {
      "step_1": "Customer identifies payer size (membership or revenue)",
      "step_2": "System loads default benchmarks for that tier",
      "step_3": "Review displays all sources and assumptions transparently",
      "step_4": "User adjusts based on actual customer volume (if known)",
      "step_5": "System recalculates with new assumptions",
      "step_6": "Final estimate saved with full source attribution"
    },
    "ui_components": {
      "benchmark_selector": {
        "component": "PayerSizeSelector",
        "props": ["onSelect", "customerMembership"],
        "options": [
          { "value": "small", "label": "Small (< 500K members)", "revenue": "$100M-$500M" },
          { "value": "medium", "label": "Medium (500K-5M members)", "revenue": "$500M-$5B" },
          { "value": "large", "label": "Large (> 5M members)", "revenue": "$5B+" }
        ]
      },
      "benchmark_display": {
        "component": "BenchmarkDefaultsDisplay",
        "props": ["payerSize", "processType"],
        "displays": [
          "Default cost estimate with range",
          "Primary benchmark (e.g., Change Healthcare)",
          "Calculation breakdown",
          "Source links",
          "Confidence score"
        ]
      },
      "adjustment_form": {
        "component": "BenchmarkAdjustmentForm",
        "props": ["benchmarkDefaults", "onSubmit"],
        "fields": [
          "Actual daily volume (claims, payments, etc.)",
          "Average transaction value (if different from benchmark)",
          "Additional assumptions",
          "Customer-specific data sources"
        ],
        "recalculates": "Automatically updates calculation and estimated value"
      }
    }
  },

