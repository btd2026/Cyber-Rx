      "edi_gateway": {
        "description": "Electronic Data Interchange gateway for X12 transactions (270/271, 276/277, 837, 835)",
        "benchmark_events": [
          {
            "name": "Change Healthcare EDI Outage (February 2024)",
            "event_type": "Real-world cyberattack",
            "daily_impact": "$285M/day (industry-wide)",
            "transactions_affected": "16M claims (6B annually)",
            "duration": "23 days",
            "sources": [
              {
                "type": "government_statement",
                "citation": "HHS Statement on Change Healthcare Cyberattack",
                "url": "https://www.hhs.gov/about/news/2024/02/27/hhs-statement-change-healthcare-cyberattack.html",
                "organization": "U.S. Department of Health and Human Services",
                "date": "2024-02-27"
              }
            ],
            "confidence": 0.9,
            "notes": "EDI gateway outage = claims adjudication outage. Same impact. Use claims adjudication benchmark for revenue impact."
          },
          {
            "name": "Industry Average X12 Volume",
            "event_type": "Processing cost baseline",
            "daily_impact": "$50K - $10M/day",
            "transactions_per_day": "10,000 - 1,000,000",
            "cost_per_transaction": "$5 - $10",
            "calculation": "Daily EDI transactions × $5-10/transaction (IT processing cost only)",
            "sources": [
              {
                "type": "industry_standard",
                "citation": "X12N Implementation Guides",
                "url": "https://x12.org/products/technical-reports-and-white-papers/",
                "organization": "X12 Organization",
                "date_accessed": "2025-06-03",
                "notes": "Each claim triggers 5 EDI transactions: 270/271 eligibility, 276/277 status, 837 claim, 835 remittance"
              }
            ],
            "confidence": 0.7,
            "notes": "Processing cost only. Revenue impact much higher - use claims adjudication benchmark."
          },
          {
            "name": "EDI Transaction Frequency Benchmark",
            "event_type": "Industry standard",
            "edi_transactions_per_claim": 5,
            "breakdown": [
              "270/271 - Eligibility inquiry (1-2 per claim)",
              "276/277 - Claim status inquiry (1-2 per claim)",
              "837 - Claim submission (1 per claim)",
              "835 - Remittance advice (1 per claim)"
            ],
            "sources": [
              {
                "type": "industry_standard",
                "citation": "X12N Transaction Frequencies",
                "url": "https://x12.org/",
                "organization": "X12 Organization",
                "date_accessed": "2025-06-03"
              }
            ],
            "confidence": 0.85,
            "notes": "Use 5 EDI transactions/claim for estimation. Large payers may have higher frequency."
          }
        ],
        "calculation_factors": {
          "edi_transactions_per_claim": 5,
          "cost_per_transaction": 10,
          "claims_volume_multiplier": 5,
          "notes": "Multiply daily claims by 5 to get EDI volume. Processing cost $5-10/transaction. Revenue impact = claims adjudication impact."
        },
        "default_benchmarks": {
          "small_payer": "$125,000/day (processing) / $375,000/day (revenue)",
          "medium_payer": "$600,000/day (processing) / $1,800,000/day (revenue)",
          "large_payer": "$5,000,000/day (processing) / $15,000,000/day (revenue)"
        }
      },

