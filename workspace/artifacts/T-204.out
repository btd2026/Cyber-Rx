    "controls": [
      {
        "id": "hipaa-164.312(a)(1)-access",
        "framework": "HIPAA Security Rule",
        "title": "Access Control - Unique User Identification",
        "requirement": "Implement unique user identification and authentication for all systems containing PHI",
        "control_type": "preventive",
        "applicable_risks": [
          "claims-ransomware",
          "claims-fraud-engineering-access",
          "claims-phishing-credential-theft",
          "billing-data-breach",
          "member-data-breach-call-center",
          "social-engineering-member-data"
        ],
        "implementation_guidance": "Implement role-based access control with least privilege. Use unique user credentials for all system access. Multi-factor authentication required. Regular access reviews.",
        "testing_procedures": "Annual access review, quarterly privileged access audit, regular MFA compliance testing",
        "provenance": {
          "source": "T-203 (HIPAA/HITRUST Control Mapping)",
          "confidence": 0.95,
          "last_updated": "2025-06-03",
