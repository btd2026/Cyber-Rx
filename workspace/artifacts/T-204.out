    "query_api": {
      "description": "REST API design for querying the reference model",
      "base_path": "/api/reference-model",
      "endpoints": [
        {
          "method": "GET",
          "path": "/processes",
          "description": "List all processes",
          "parameters": {
            "query": [
              {
                "name": "limit",
                "type": "integer",
                "description": "Maximum number of results to return",
                "default": 100
              },
              {
                "name": "offset",
                "type": "integer",
                "description": "Number of results to skip",
                "default": 0
              }
            ]
          },
          "response": {
            "processes": ["process object"],
            "total": "integer",
            "limit": "integer",
            "offset": "integer"
          }
        },
        {
          "method": "GET",
          "path": "/processes/:id",
          "description": "Get specific process by ID",
          "parameters": {
            "path": [
              {
                "name": "id",
                "type": "string",
                "description": "Process ID (e.g., 'claims-adjudication')",
                "required": true
              }
            ]
          },
          "response": {
            "process": "process object with sub_processes, typical_applications, provenance"
          }
        },
        {
          "method": "GET",
          "path": "/processes/:id/applications",
          "description": "Get applications supporting a specific process",
          "parameters": {
            "path": [
              {
                "name": "id",
                "type": "string",
                "description": "Process ID",
                "required": true
              }
            ]
          },
          "response": {
            "applications": ["application object"],
            "process_id": "string",
            "process_name": "string"
          }
        },
        {
          "method": "GET",
          "path": "/processes/:id/risks",
          "description": "Get risks associated with a specific process",
          "parameters": {
            "path": [
              {
                "name": "id",
                "type": "string",
                "description": "Process ID",
                "required": true
              }
            ]
          },
          "response": {
            "risks": ["risk object"],
            "process_id": "string",
            "process_name": "string"
          }
        },
        {
          "method": "GET",
          "path": "/applications",
          "description": "List all applications",
          "parameters": {
            "query": [
              {
                "name": "criticality",
                "type": "string",
                "description": "Filter by criticality (crown-jewel, high, medium)"
              },
              {
                "name": "limit",
                "type": "integer",
                "description": "Maximum number of results",
                "default": 100
              }
            ]
          },
          "response": {
            "applications": ["application object"],
            "total": "integer"
          }
        },
        {
          "method": "GET",
          "path": "/applications/:id",
          "description": "Get specific application by ID",
          "parameters": {
            "path": [
              {
                "name": "id",
                "type": "string",
                "description": "Application ID (e.g., 'claims-adjudication-system')",
                "required": true
              }
            ]
          },
          "response": {
            "application": "application object with supported_processes, typical_vendors, provenance"
          }
        },
        {
          "method": "GET",
          "path": "/applications/:id/processes",
          "description": "Get processes supported by a specific application",
          "parameters": {
            "path": [
              {
                "name": "id",
                "type": "string",
                "description": "Application ID",
                "required": true
              }
            ]
          },
          "response": {
            "processes": ["process object"],
            "application_id": "string",
            "application_name": "string"
          }
        },
        {
          "method": "GET",
          "path": "/applications/:id/risks",
          "description": "Get risks associated with a specific application",
          "parameters": {
            "path": [
              {
                "name": "id",
                "type": "string",
                "description": "Application ID",
                "required": true
              }
            ]
          },
          "response": {
            "risks": ["risk object"],
            "application_id": "string",
            "application_name": "string"
          }
        },
        {
          "method": "GET",
          "path": "/risks",
          "description": "List all risks",
          "parameters": {
            "query": [
              {
                "name": "category",
                "type": "string",
                "description": "Filter by category (operational, security, financial, compliance)"
              },
              {
                "name": "severity",
                "type": "string",
                "description": "Filter by severity (critical, high, medium, low)"
              },
              {
                "name": "process_id",
                "type": "string",
                "description": "Filter by affected process"
              },
              {
                "name": "app_id",
                "type": "string",
                "description": "Filter by affected application"
              }
            ]
          },
          "response": {
            "risks": ["risk object"],
            "total": "integer"
          }
        },
        {
          "method": "GET",
          "path": "/risks/:id",
          "description": "Get specific risk by ID",
          "parameters": {
            "path": [
              {
                "name": "id",
                "type": "string",
                "description": "Risk ID (e.g., 'claims-outage')",
                "required": true
              }
            ]
          },
          "response": {
            "risk": "risk object with affected_processes, affected_applications, controls"
          }
        },
        {
          "method": "GET",
          "path": "/risks/:id/controls",
          "description": "Get controls that mitigate a specific risk",
          "parameters": {
            "path": [
              {
                "name": "id",
                "type": "string",
                "description": "Risk ID",
                "required": true
              }
            ]
          },
          "response": {
            "controls": ["control object"],
            "risk_id": "string",
            "risk_title": "string"
          }
        },
        {
          "method": "GET",
          "path": "/controls",
          "description": "List all controls",
          "parameters": {
            "query": [
              {
                "name": "framework",
                "type": "string",
                "description": "Filter by framework (HIPAA Security Rule, HITRUST CSF)"
              },
              {
                "name": "control_type",
                "type": "string",
                "description": "Filter by control type (preventive, detective, corrective)"
              }
            ]
          },
          "response": {
            "controls": ["control object"],
            "total": "integer"
          }
        },
        {
          "method": "GET",
          "path": "/controls/:id",
          "description": "Get specific control by ID",
          "parameters": {
            "path": [
              {
                "name": "id",
                "type": "string",
                "description": "Control ID (e.g., 'hipaa-164.312(a)(1)-access')",
                "required": true
              }
            ]
          },
          "response": {
            "control": "control object with applicable_risks, implementation_guidance"
          }
        },
        {
          "method": "GET",
          "path": "/controls/:id/risks",
          "description": "Get risks mitigated by a specific control",
          "parameters": {
            "path": [
              {
                "name": "id",
                "type": "string",
                "description": "Control ID",
                "required": true
              }
            ]
          },
          "response": {
            "risks": ["risk object"],
            "control_id": "string",
            "control_title": "string"
          }
        },
        {
          "method": "GET",
          "path": "/relationships",
          "description": "List all relationships",
          "parameters": {
            "query": [
              {
                "name": "from",
                "type": "string",
                "description": "Filter by from entity (e.g., 'process:claims-adjudication')"
              },
              {
                "name": "to",
                "type": "string",
                "description": "Filter by to entity (e.g., 'app:claims-adjudication-system')"
              },
              {
                "name": "type",
                "type": "string",
                "description": "Filter by relationship type (supported_by, affects, mitigated_by, depends_on)"
              }
            ]
          },
          "response": {
            "relationships": ["relationship object"],
            "total": "integer"
          }
        },
        {
          "method": "GET",
          "path": "/relationships/:id",
          "description": "Get specific relationship by ID",
          "parameters": {
            "path": [
              {
                "name": "id",
                "type": "string",
                "description": "Relationship ID (e.g., 'rel-001')",
                "required": true
              }
            ]
          },
          "response": {
            "relationship": "relationship object with from, to, type, confidence"
          }
        },
        {
          "method": "GET",
          "path": "/search",
          "description": "Full-text search across all entities",
          "parameters": {
            "query": [
              {
                "name": "q",
                "type": "string",
                "description": "Search query",
                "required": true
              },
              {
                "name": "entity_type",
                "type": "string",
                "description": "Filter by entity type (processes, applications, risks, controls)"
              },
              {
                "name": "limit",
                "type": "integer",
                "description": "Maximum number of results",
                "default": 50
              }
            ]
          },
          "response": {
            "results": [
              {
                "entity_type": "string",
                "id": "string",
                "title": "string",
                "description": "string",
                "relevance_score": "float"
              }
            ],
            "total": "integer"
          }
        },
        {
          "method": "GET",
          "path": "/metadata",
          "description": "Get reference model metadata",
          "parameters": {},
          "response": {
            "version": "string",
            "status": "string",
            "last_updated": "string",
            "metadata": "object",
            "statistics": {
              "total_processes": "integer",
              "total_applications": "integer",
              "total_risks": "integer",
              "total_controls": "integer",
              "total_relationships": "integer"
            }
          }
        }
      ]
    },
    "versioning_strategy": {
      "description": "Semantic versioning for reference model releases",
      "format": "MAJOR.MINOR.PATCH-status",
      "rules": {
        "MAJOR": "Breaking changes - schema changes, entity deletions, relationship type changes",
        "MINOR": "Non-breaking additions - new entities, new relationships, new fields",
        "PATCH": "Bug fixes, documentation updates, provenance updates",
        "status": "Draft status indicators: -draft, -rc, -final"
      },
      "examples": {
        "initial_draft": "1.0.0-draft",
        "expert_review": "1.0.0-rc",
        "first_release": "1.0.0",
        "new_processes": "1.1.0",
        "documentation_fix": "1.1.1",
        "breaking_schema_change": "2.0.0-draft"
      },
