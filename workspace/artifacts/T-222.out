    "api_endpoint": {
      "method": "GET",
      "path": "/api/mappings/:matchId/gaps",
      "description": "Generate gap analysis for a set of confirmed mappings",
      "authentication": "Bearer token required",
      "parameters": {
        "path": [
          {
            "name": "matchId",
            "type": "UUID",
            "required": true,
            "description": "Match process ID from T-213"
          }
        ],
        "query": [
          {
            "name": "include_benefits",
            "type": "boolean",
            "default": true,
            "description": "Include suggested actions and business impact"
          },
          {
            "name": "severity_filter",
            "type": "string",
            "enum": ["critical", "high", "medium", "all"],
            "default": "all",
            "description": "Filter gaps by severity"
          }
        ]
      },
      "response": {
        "200": "Gap analysis JSON",
        "404": "Match not found",
        "400": "Invalid match ID or mappings not confirmed",
        "500": "Server error during gap detection"
      },
      "implementation": {
        "backend": "Express.js route handler",
        "controller": "GapDetectionController.detectGaps(matchId)",
        "service": "GapDetectionService.detectGaps(confirmedMappings, referenceModel)",
        "dependencies": [
          "T-213 Match API - fetch confirmed mappings",
          "T-204 Reference Model - fetch expected entities",
          "T-220 Review UI - confirmed proposals"
        ]
      }
    },

