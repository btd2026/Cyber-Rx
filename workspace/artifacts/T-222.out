{
  "version": "1.0.0",
  "task_id": "T-222",
  "title": "Gap Detection from Reference Model",
  "created_at": "2025-06-03T19:00:00Z",
  "status": "complete",

  "gap_detection_service": {
    "algorithm": {
      "name": "Model-Based Gap Detection",
      "description": "Compares reference model expectations against confirmed customer mappings to identify missing processes and crown-jewel applications",
      "approach": "Set-based difference analysis between expected entities and confirmed entities",
      "network_scanning": false,
      "detection_method": "Reference model comparison only - no network scanning or discovery"
    },

    "detection_logic": {
      "core_algorithm": "detectGaps(confirmedMappings, referenceModel)",
      "inputs": {
        "confirmed_mappings": "Array of mappings accepted by human in T-220",
        "reference_model": "Reference model from T-204 with expected processes and applications"
      },
      "steps": [
        "1. Extract set of confirmed process IDs from accepted mappings",
        "2. Extract set of confirmed application IDs from accepted mappings",
        "3. Retrieve all expected processes from reference model",
        "4. Retrieve all expected applications from reference model",
        "5. For each expected process: check if present in confirmed set",
        "6. For each expected crown-jewel application: check if present in confirmed set",
        "7. Flag missing entities as gaps with severity and rationale",
        "8. Generate suggested actions for each gap",
        "9. Prioritize gaps by severity and business impact"
      ],
      "implementation": {
        "language": "JavaScript/Node.js (backend) and React (frontend)",
        "data_structures": "Sets for O(1) lookup, arrays for gap reporting",
        "confidence_scoring": "Binary (0 or 1) - gap exists or does not exist",
        "edge_cases": [
          "Customer may outsource process to vendor - flag as potential gap",
          "Customer may have process under different name - suggest manual review",
          "Small payers may not have all processes - flag with 'may not apply'",
          "Crown-jewel apps always flagged if missing - critical regardless of payer size"
        ]
      }
    },

    "gap_categories": {
      "CRITICAL_CROWN_JEWEL": {
        "category_id": "critical-crown-jewel",
        "name": "Crown-Jewel System Missing",
        "severity": "critical",
        "description": "Critical crown-jewel application that is foundational to payer operations",
        "business_impact": "Cannot operate without this system - revenue and care access impact",
        "examples": [
          "Claims Adjudication System",
          "EDI Gateway / X12 Translator"
        ],
        "priority": 1,
        "suggested_actions": [
          "URGENT: Verify if system truly missing or outsourced",
          "Check if using managed service (Change Healthcare, Optum, etc.)",
          "If confirmed missing, immediate security and operational risk",
          "Escalate to CIO/CTO for validation"
        ]
      },
      "EXPECTED_STANDARD": {
        "category_id": "expected-standard",
        "name": "Standard Payer System Missing",
        "severity": "high",
        "description": "Standard healthcare payer system expected for typical operations",
        "business_impact": "Operational inefficiencies, compliance risks, provider/member friction",
        "examples": [
          "Provider Data Management",
          "Prior Authorization System",
          "Payment & Remittance System",
          "Pharmacy Benefit Manager (PBM) System"
        ],
        "priority": 2,
        "suggested_actions": [
          "Verify if process exists under different name or custom solution",
          "Check if function is outsourced to vendor or BAO",
          "Confirm if truly not applicable to this payer's business model",
          "Assess compliance impact if missing"
        ]
      },
      "INDUSTRY_BEST_PRACTICE": {
        "category_id": "industry-best-practice",
        "name": "Best-Practice System Missing",
        "severity": "medium",
        "description": "Industry best-practice system that enhances operational excellence",
        "business_impact": "Competitive disadvantage, member experience gaps, quality measurement challenges",
        "examples": [
          "Care Management Platform",
          "Analytics & Data Warehouse",
          "Member Services Portal",
          "Fraud Detection System"
        ],
        "priority": 3,
        "suggested_actions": [
          "Assess business case for implementation",
          "Check if functions handled manually or in other systems",
          "Consider phased implementation for competitive advantage",
          "May be acceptable gap for smaller payers"
        ]
      },
      "MISSING_PROCESS": {
        "category_id": "missing-process",
        "name": "Core Process Missing",
        "severity": "high",
        "description": "Core business process not identified in customer environment",
        "business_impact": "Cannot perform core payer operations - revenue or compliance impact",
        "examples": [
          "Claims Adjudication Process",
          "Member Enrollment Process",
          "Provider Management Process"
        ],
        "priority": 2,
        "suggested_actions": [
          "Verify if process exists under different terminology",
          "Check if process is manual or outsourced",
          "Confirm process is truly not applicable",
          "Assess regulatory requirements for this process"
        ]
      }
    },

    "gap_detection_algorithm": {
      "function_signature": "detectGaps(confirmedMappings, referenceModel)",
      "parameters": {
        "confirmedMappings": {
          "type": "Array<Object>",
          "description": "Mappings accepted by human in T-220",
          "fields": ["proposal_id", "process_id", "application_ids", "customer_process_name", "confidence"]
        },
        "referenceModel": {
          "type": "Object",
          "description": "Reference model from T-204",
          "fields": ["processes", "applications", "relationships", "risks", "controls"]
        }
      },
      "returns": {
        "type": "Object",
        "fields": ["gap_analysis", "gaps", "summary"]
      },
      "pseudocode": `
function detectGaps(confirmedMappings, referenceModel) {
  const gaps = [];

  // Step 1: Extract confirmed entity IDs
  const confirmedProcessIds = new Set(
    confirmedMappings.map(m => m.process_id).filter(Boolean)
  );
  const confirmedAppIds = new Set(
    confirmedMappings.flatMap(m => m.application_ids || []).filter(Boolean)
  );

  // Step 2: Get expected entities from reference model
  const expectedProcesses = referenceModel.processes;
  const expectedApps = referenceModel.applications;

  // Step 3: Find missing processes
  expectedProcesses.forEach(process => {
    if (!confirmedProcessIds.has(process.id)) {
      const severity = determineProcessSeverity(process, referenceModel);
      gaps.push({
        gap_id: generateGapId(),
        type: 'missing_process',
        severity: severity,
        entity_type: 'process',
        entity_id: process.id,
        entity_name: process.name,
        entity_description: process.description,
        rationale: generateGapRationale(process, 'process'),
        confidence: 0.90,
        suggested_actions: generateSuggestedActions(process, 'process'),
        business_impact: generateBusinessImpact(process, 'process')
      });
    }
  });

  // Step 4: Find missing crown-jewel applications (CRITICAL only)
  expectedApps
    .filter(app => app.criticality === 'crown-jewel')
    .forEach(app => {
      if (!confirmedAppIds.has(app.id)) {
        gaps.push({
          gap_id: generateGapId(),
          type: 'missing_crown_jewel_app',
          severity: 'critical',
          entity_type: 'application',
          entity_id: app.id,
          entity_name: app.name,
          entity_description: app.description,
          rationale: generateGapRationale(app, 'crown-jewel'),
          confidence: 0.95,
          suggested_actions: generateSuggestedActions(app, 'crown-jewel'),
          business_impact: generateBusinessImpact(app, 'crown-jewel')
        });
      }
    });

  // Step 5: Prioritize gaps by severity
  const prioritizedGaps = gaps.sort((a, b) => {
    const severityOrder = { critical: 0, high: 1, medium: 2, low: 3 };
    return severityOrder[a.severity] - severityOrder[b.severity];
  });

  // Step 6: Generate summary statistics
  const summary = {
    total_gaps: gaps.length,
    critical_gaps: gaps.filter(g => g.severity === 'critical').length,
    high_gaps: gaps.filter(g => g.severity === 'high').length,
    medium_gaps: gaps.filter(g => g.severity === 'medium').length,
    missing_processes: gaps.filter(g => g.entity_type === 'process').length,
    missing_applications: gaps.filter(g => g.entity_type === 'application').length,
    crown_jewel_gaps: gaps.filter(g => g.type === 'missing_crown_jewel_app').length
  };

  return {
    gap_analysis: {
      match_id: generateMatchId(),
      customer_id: getCustomerId(),
      analysis_date: new Date().toISOString(),
      ...summary
    },
    gaps: prioritizedGaps,
    summary: summary
  };
}

function determineProcessSeverity(process, referenceModel) {
  // Check if process is supported by crown-jewel apps
  const crownJewelApps = referenceModel.applications.filter(a =>
    a.criticality === 'crown-jewel' &&
    a.supported_processes?.includes(process.id)
  );

  if (crownJewelApps.length > 0) {
    return 'critical'; // Process supported by crown-jewel app
  }

  // Check if process is in core payer operations
  const coreProcesses = [
    'claims-adjudication',
    'enrollment-and-billing',
    'provider-management',
    'payment-processing'
  ];

  if (coreProcesses.includes(process.id)) {
    return 'high'; // Core payer process
  }

  return 'medium'; // Other processes
}

function generateGapRationale(entity, entityType) {
  if (entityType === 'crown-jewel') {
    return 'Crown jewel application missing - cannot operate without this system or confirmed managed service';
  }
  if (entityType === 'process') {
    return 'Reference model expects this core process but customer data shows no equivalent';
  }
  return 'Reference model indicates this entity should exist but not found in customer data';
}

function generateSuggestedActions(entity, entityType) {
  if (entityType === 'crown-jewel') {
    return [
      'URGENT: Verify if system truly missing or outsourced to managed service',
      'Check if using Change Healthcare, Optum, or similar vendor',
      'If confirmed missing, immediate security and operational risk',
      'Escalate to CIO/CTO for validation',
      'Document any manual workarounds or backup procedures'
    ];
  }
  if (entityType === 'process') {
    return [
      'Verify if process exists under different name or terminology',
      'Check if process is outsourced to vendor or BAO',
      'Confirm if process is truly not applicable to this payer',
      'Assess regulatory and compliance requirements',
      'Document manual procedures if process is manual'
    ];
  }
  return [
    'Verify if entity exists under different name',
    'Check if function is handled by other systems',
    'Assess business impact if truly missing'
  ];
}

function generateBusinessImpact(entity, entityType) {
  if (entityType === 'crown-jewel') {
    return 'Cannot process X12 transactions, receive claims, or make payments - immediate revenue and member care impact';
  }
  if (entity.id === 'claims-adjudication') {
    return 'Cannot process healthcare claims - revenue operations halted';
  }
  if (entity.id === 'enrollment-and-billing') {
    return 'Cannot enroll members or collect premiums - revenue leakage';
  }
  if (entity.id === 'provider-management') {
    return 'Provider network may have stale data - claim routing and member access issues';
  }
  if (entity.id === 'payment-processing') {
    return 'Cannot reimburse providers - provider network dissatisfaction and contract violations';
  }
  return 'Operational inefficiency and potential compliance gaps';
}
      `
    },

    "gap_report_format": {
      "schema": {
        "gap_analysis": {
          "match_id": "UUID of the match process",
          "customer_id": "Customer identifier",
          "analysis_date": "ISO 8601 timestamp",
          "total_gaps": "Integer count of all gaps",
          "critical_gaps": "Integer count of critical severity gaps",
          "high_gaps": "Integer count of high severity gaps",
          "medium_gaps": "Integer count of medium severity gaps"
        },
        "gaps": "Array of gap objects (see schema below)",
        "summary": {
          "missing_processes": "Integer count",
          "missing_applications": "Integer count",
          "crown_jewel_gaps": "Integer count",
          "recommended_priority": "String description"
        }
      },
      "gap_object_schema": {
        "gap_id": "String - Unique gap identifier (gap-1, gap-2, etc.)",
        "type": "String - Gap type: missing_process, missing_crown_jewel_app",
        "severity": "String - Severity: critical, high, medium",
        "entity_type": "String - Entity type: process or application",
        "entity_id": "String - Reference model entity ID",
        "entity_name": "String - Entity name",
        "entity_description": "String - Entity description from reference model",
        "rationale": "String - Why this gap was flagged",
        "confidence": "Float - Confidence score (0.0 to 1.0)",
        "suggested_actions": "Array<String> - Recommended actions",
        "business_impact": "String - Business impact description",
        "edi_transactions": "Array<String> - Affected EDI transactions (if applicable)",
        "supported_processes": "Array<String> - Processes supported by missing application (if applicable)"
      }
    },

