          "handling": "Flag as critical gap, require executive sign-off if dismissed",
          "confidence": 0.95,
          "requires_human_review": true
        }
      ],
      "validation_rules": [
        "Only flag gaps for entities in reference model - no speculation",
        "Crown-jewel applications always flagged if missing (critical severity)",
        "Standard processes flagged if missing (high severity)",
        "Best-practice processes flagged with medium severity",
        "Never flag applications as missing unless crown-jewel criticality",
        "Confidence scores reflect uncertainty: 0.95 for crown-jewel, 0.90 for processes, 0.80 for best-practice",
        "All gaps require human review before final disposition"
      ]
    },

