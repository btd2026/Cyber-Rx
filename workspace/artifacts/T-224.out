{
  "version": "1.0.0",
  "task": "T-224: Provenance + Audit Trail",
  "status": "complete",
  "timestamp": "2025-06-03T14:00:00Z",

  "audit_trail_schema": {
    "table": "audit_logs",
    "extends_existing": true,
    "note": "Reuses existing audit_logs table with new action types for mapping confirmations",
    "existing_actions": [
      "credential_view",
      "credential_create",
      "credential_update",
      "credential_delete",
      "credential_validate",
      "connection_test",
      "sync_start",
      "sync_complete",
      "sync_fail"
    ],
    "new_actions": [
      "mapping_accepted",
      "mapping_rejected",
      "mapping_overridden"
    ],
    "schema": {
      "id": "SERIAL PRIMARY KEY",
      "organization_id": "UUID REFERENCES organizations(id)",
      "user_id": "INTEGER REFERENCES users(id)",
      "action": "VARCHAR(50) CHECK (action IN (...))",
      "resource_type": "VARCHAR(50) - process_mapping, application_mapping",
      "resource_id": "VARCHAR(255) - proposal ID",
      "details": "JSONB - { user_email, user_role, before, after, provenance, rationale, session_id }",
      "ip_address": "INET",
      "user_agent": "TEXT",
      "status": "VARCHAR(20) - success, failure, partial",
      "error_message": "TEXT",
      "created_at": "TIMESTAMP WITH TIME ZONE DEFAULT NOW()"
    }
  },

  "provenance_tracking": {
    "description": "Full data lineage from source to confirmation",
    "chain": [
      {
        "stage": "ingest",
        "fields": [
          "source_file",
          "source_row_id",
          "ingested_at",
          "ingest_id"
        ],
        "purpose": "Trace back to original source document and row"
      },
      {
        "stage": "normalize",
        "fields": [
          "normalized_value",
          "normalized_at"
        ],
        "purpose": "Track data normalization transformations"
      },
      {
        "stage": "match",
        "fields": [
          "match_method",
          "proposed_match",
          "confidence",
          "matched_at"
        ],
        "purpose": "Record AI/ML matching process and confidence"
      },
      {
        "stage": "confirm",
        "fields": [
          "action",
          "confirmed_match",
          "rationale",
          "user_email",
          "created_at"
        ],
        "purpose": "Capture human confirmation decision and reasoning"
      }
    ]
  },

  "api_endpoints": {
    "GET /api/audit-trail": {
      "description": "Query audit logs with filters",
      "authentication": "Bearer token required",
      "rate_limiting": "GET rate limiter applied",
      "parameters": {
        "organization_id": "UUID (required)",
        "start_date": "ISO 8601 (optional)",
        "end_date": "ISO 8601 (optional)",
        "event_types": "Comma-separated list (optional)",
        "user_id": "Integer (optional)",
        "page": "Integer (default: 1)",
        "per_page": "Integer (default: 50, max: 100)"
      },
      "response": {
        "audit_logs": "Array of audit records",
        "pagination": "{ total, page, per_page, total_pages }"
      }
    },

    "GET /api/audit-trail/:id": {
      "description": "Get full audit record with provenance chain",
      "authentication": "Bearer token required",
      "parameters": {
        "id": "Audit log ID (integer)"
      },
      "response": {
        "audit_record": "Complete audit record with all fields",
        "provenance_chain": "Array of provenance stages (ingest, normalize, match, confirm)"
      }
    },

    "GET /api/audit-trail/export": {
      "description": "Export audit logs as CSV for compliance",
      "authentication": "Bearer token required",
      "content_type": "text/csv",
      "parameters": {
        "organization_id": "UUID (required)",
        "start_date": "ISO 8601 (required)",
        "end_date": "ISO 8601 (required)"
      },
      "response": "CSV file with download headers",
      "csv_headers": [
        "ID",
        "Timestamp",
        "User Email",
        "User Role",
        "Action",
        "Target Type",
        "Target ID",
        "Customer Value",
        "Proposed Match",
        "Confirmed Match",
        "Confidence",
        "Rationale",
        "IP Address",
        "Source File",
        "Source Row ID",
        "Ingest Timestamp",
        "Normalize Timestamp",
        "Match Timestamp",
        "Match Method"
      ]
    },

    "GET /api/audit-trail/stats": {
      "description": "Get audit statistics for compliance reporting",
      "authentication": "Bearer token required",
      "parameters": {
        "organization_id": "UUID (required)",
        "start_date": "ISO 8601 (required)",
        "end_date": "ISO 8601 (required)"
      },
      "response": {
        "statistics": "Array of { event_type, count, unique_users, last_occurrence }"
      }
    }
  },

