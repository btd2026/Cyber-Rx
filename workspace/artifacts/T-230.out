{
  "version": "1.0.0",
  "task_id": "T-230",
  "title": "Downtime Cost per Day with Source + Assumption",
  "created_date": "2025-06-03",
  "status": "complete",

  "schema_extension": {
    "field_name": "downtime_cost_per_day",
    "description": "Structured downtime cost estimation with source attribution, assumptions, and confidence scoring",
    "required_fields": [
      "estimated_value",
      "currency",
      "source",
      "assumptions",
      "calculation",
      "confidence",
      "last_reviewed",
      "review_frequency"
    ],

    "json_schema": {
      "type": "object",
      "properties": {
        "estimated_value": {
          "type": "number",
          "description": "Estimated daily financial impact in specified currency",
          "example": 1500000
        },
        "currency": {
          "type": "string",
          "enum": ["USD", "EUR", "GBP"],
          "default": "USD"
        },
        "source": {
          "type": "object",
          "description": "Primary source citation for the cost estimate",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["public_benchmark", "industry_report", "internal_data", "regulatory_filing", "actuarial_study"],
              "description": "Category of source"
            },
            "citation": {
              "type": "string",
              "description": "Human-readable source description",
              "example": "Change Healthcare Cyberattack Impact, Feb 2024"
            },
            "url": {
              "type": "string",
              "format": "uri",
              "description": "Publicly accessible URL to source document"
            },
            "date_accessed": {
              "type": "string",
              "format": "date",
              "description": "Date source was last accessed/verified"
            },
            "organization": {
              "type": "string",
              "description": "Publishing organization (e.g., HHS, CMS, Kaiser Family Foundation)"
            }
          },
          "required": ["type", "citation"]
        },
        "assumptions": {
          "type": "array",
          "description": "List of explicit assumptions underlying the cost calculation",
          "items": {
            "type": "object",
            "properties": {
              "assumption": {
                "type": "string",
                "description": "Specific assumption made (e.g., transaction volume, unit cost)",
                "example": "10,000 claims/day processed"
              },
              "source": {
                "type": "string",
                "description": "Source or basis for the assumption",
                "example": "Payer annual report (Form 10-K)"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Confidence score (0-1) in this assumption's accuracy",
                "example": 0.9
              }
            },
            "required": ["assumption", "source", "confidence"]
          }
        },
        "calculation": {
          "type": "string",
          "description": "Transparent calculation formula showing how estimate was derived",
          "example": "10,000 claims/day × $150/claim × 1 day = $1,500,000"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Overall confidence in the estimate (aggregated from assumptions)",
          "example": 0.8
        },
        "range": {
          "type": "object",
          "description": "Optional range for low/high estimates",
          "properties": {
            "low": {
              "type": "number",
              "description": "Conservative estimate (e.g., 50% volume)"
            },
            "high": {
              "type": "number",
              "description": "Worst-case estimate (e.g., catch-up processing)"
            }
          }
        },
        "last_reviewed": {
          "type": "string",
          "format": "date",
          "description": "Date this estimate was last validated/updated"
        },
        "review_frequency": {
          "type": "string",
          "enum": ["monthly", "quarterly", "semi-annual", "annual"],
          "description": "How often this estimate should be reviewed"
        },
        "notes": {
          "type": "string",
          "description": "Additional context or caveats about the estimate"
        }
      },
      "required": ["estimated_value", "currency", "source", "assumptions", "calculation", "confidence", "last_reviewed", "review_frequency"]
    },

    "example_complete": {
      "process_id": "claims-adjudication",
      "process_name": "Claims Adjudication",
      "downtime_cost_per_day": {
        "estimated_value": 1500000,
        "currency": "USD",
        "source": {
          "type": "public_benchmark",
          "citation": "Change Healthcare Cyberattack Impact, Feb 2024 - $6B in claims over 3 weeks",
          "url": "https://www.hhs.gov/about/news/2024/02/27/hhs-statement-change-healthcare-cyberattack.html",
          "date_accessed": "2025-06-03",
          "organization": "U.S. Department of Health and Human Services"
        },
        "assumptions": [
          {
            "assumption": "10,000 claims/day processed",
            "source": "Payer annual report (Form 10-K)",
            "confidence": 0.9
          },
          {
            "assumption": "$150 average claim value",
            "source": "CMS Healthcare Common Fee Schedule",
            "confidence": 0.8
          },
          {
            "assumption": "100% outage = 0 claims processed",
            "source": "Industry worst-case scenario benchmark",
            "confidence": 0.7
          },
          {
            "assumption": "No manual workaround available",
            "source": "Change Healthcare breach analysis",
            "confidence": 0.6
          }
        ],
        "calculation": "10,000 claims/day × $150/claim × 1 day = $1,500,000/day",
        "confidence": 0.8,
        "range": {
          "low": 750000,
          "high": 3000000
        },
        "last_reviewed": "2025-06-03",
        "review_frequency": "quarterly",
        "notes": "Based on medium-sized payer (500K-5M members). Larger payers may exceed $3M/day."
      }
    }
  },

  "public_benchmarks": {
    "description": "Library of publicly available benchmarks for healthcare payer downtime costs",

    "change_healthcare_breach_2024": {
      "title": "Change Healthcare Cyberattack (February 2024)",
      "event_summary": "Ransomware attack on UnitedHealth Group's Change Healthcare unit",
      "impact_overview": {
        "total_impact": "$6 billion+ in claims delayed",
        "duration": "21+ days of significant disruption",
        "daily_impact_estimate": "~$285M/day industry-wide",
        "affected_organizations": "1 in 3 US patients impacted",
        "claims_delayed": "tens of millions of claims"
      },
      "sources": [
        {
          "type": "government_statement",
          "citation": "HHS Statement on Change Healthcare Cyberattack",
          "url": "https://www.hhs.gov/about/news/2024/02/27/hhs-statement-change-healthcare-cyberattack.html",
          "organization": "U.S. Department of Health and Human Services",
          "date": "2024-02-27"
        },
        {
          "type": "sec_filing",
          "citation": "UnitedHealth Group Q1 2024 Earnings Report",
          "url": "https://investors.unitedhealth.com/news-releases/news-release-details/unitedhealth-group-announces-first-quarter-2024-results",
          "organization": "UnitedHealth Group",
          "date": "2024-04-16"
        },
        {
          "type": "congressional_testimony",
          "citation": "Senate Finance Committee Hearing on Change Healthcare Attack",
          "url": "https://www.finance.senate.gov/hearings/lessons-from-the-change-healthcare-cyberattack",
          "organization": "U.S. Senate Committee on Finance",
          "date": "2024-05-01"
        }
      ],
      "applicable_processes": [
        "claims-adjudication",
        "edi-gateway",
        "payment-processing",
        "provider-enrollment",
        "eligibility-verification"
      ],
      "cost_extraction_methodology": "Total industry impact ($6B) divided by disruption duration (21 days) = ~$285M/day across all affected payers",
      "confidence": 0.9,
      "last_updated": "2025-06-03"
    },

