  "calculation_templates": {
    "description": "Standardized calculation formulas for estimating downtime costs by process type",

    "claims_adjudication": {
      "formula": "daily_claims_volume × average_claim_value",
      "transaction_volume": {
        "value": 10000,
        "unit": "claims/day",
        "source": "Payer annual report (Form 10-K)",
        "confidence": 0.9,
        "methodology": "Annual claims volume / 365 business days"
      },
      "transaction_value": {
        "value": 150,
        "unit": "dollars/claim",
        "source": "CMS Healthcare Common Fee Schedule",
        "confidence": 0.8,
        "methodology": "Weighted average across professional, institutional, and other claim types"
      },
      "calculation": "10,000 claims/day × $150/claim = $1,500,000/day",
      "estimated_value": 1500000,
      "range": {
        "low": 750000,
        "high": 3000000,
        "low_explanation": "50% of normal volume with manual workaround",
        "high_explanation": "200% catch-up processing on recovery day"
      },
      "confidence": 0.8,
      "primary_benchmark": "change_healthcare_breach_2024",
      "notes": [
        "Actual impact includes delayed payments to providers (cash flow impact)",
        "Manual workaround costs not included (labor, overtime)",
        "Member abrasion and regulatory penalties not included in base estimate"
      ]
    },

    "edi_gateway": {
      "formula": "daily_transaction_volume × processing_cost_per_transaction",
      "transaction_volume": {
        "value": 50000,
        "unit": "X12 transactions/day",
        "source": "EDI transaction logs (837, 835, 270/271, 278)",
        "confidence": 0.9,
        "methodology": "Sum of all X12 transactions processed daily"
      },
      "transaction_value": {
        "value": 2,
        "unit": "dollars/transaction",
        "source": "Industry averages for EDI processing costs",
        "confidence": 0.7,
        "methodology": "Internal IT cost allocation per transaction"
      },
      "calculation": "50,000 transactions/day × $2/transaction = $100,000/day",
      "estimated_value": 100000,
      "range": {
        "low": 50000,
        "high": 500000
      },
      "confidence": 0.7,
      "primary_benchmark": "change_healthcare_breach_2024",
      "notes": [
        "This ONLY measures processing cost, NOT business impact",
        "Real impact = claims/payment delays (see claims_adjudication)",
        "Use Change Healthcare benchmark for actual revenue impact"
      ],
      "alternative_calculation": {
        "description": "Revenue impact (preferred)",
        "formula": "Use claims_adjudication downtime cost as proxy",
        "rationale": "EDI gateway outage = claims adjudication outage",
        "estimated_value": 1500000,
        "source": "Change Healthcare breach analysis"
      }
    },

    "payment_processing": {
      "formula": "daily_payment_volume × cost_of_payment_delay",
      "transaction_volume": {
        "value": 10000,
        "unit": "payments/day",
        "source": "Payer accounts payable data",
        "confidence": 0.9,
        "methodology": "Adjudicated claims resulting in payment"
      },
      "transaction_value": {
        "value": 150,
        "unit": "dollars/payment",
        "source": "Average payment per claim",
        "confidence": 0.8,
        "methodology": "Matches claims adjudication average value"
      },
      "calculation": "10,000 payments/day × $150/payment = $1,500,000/day",
      "estimated_value": 1500000,
      "range": {
        "low": 750000,
        "high": 3000000
      },
      "confidence": 0.8,
      "primary_benchmark": "change_healthcare_breach_2024",
      "impact_components": {
        "provider_cash_flow": "Delayed payments = provider cash flow crisis",
        "late_payment_penalties": "Potential contractual penalties for late payments",
        "manual_payment_costs": "Emergency check issuance/wires cost $5-15 per payment",
        "provider_abrasion": "Damage to provider relationships"
      },
      "notes": [
        "Many providers operate on thin margins; payment delays are critical",
        "Emergency manual payments add 5-10% overhead"
      ]
    },

    "prior_authoration": {
      "formula": "daily_pa_volume × (delay_cost + denied_service_cost)",
      "transaction_volume": {
        "value": 2000,
        "unit": "PA requests/day",
        "source": "Prior authorization tracking system",
        "confidence": 0.9,
        "methodology": "Average PA volume for medium payer"
      },
      "transaction_value": {
        "component": "delay_impact",
        "delay_cost_per_pa": {
          "value": 500,
          "unit": "dollars/PA",
          "source": "Industry PA delay cost studies",
          "confidence": 0.7,
          "breakdown": "Provider administrative time ($200) + Patient care delay ($300)"
        },
        "denied_service_impact": {
          "value": 1500,
          "unit": "dollars/denied_service",
          "source": "Medical cost offset analysis",
          "confidence": 0.6,
          "note": "PA outage = delayed care = potential emergency care later"
        }
      },
      "calculation": "2,000 PA/day × $500/PA = $1,000,000/day",
      "estimated_value": 1000000,
      "range": {
        "low": 500000,
        "high": 2000000
      },
      "confidence": 0.7,
      "primary_benchmark": "Industry PA delay cost studies",
      "notes": [
        "PA delays can cause care delays = adverse health events",
        "Emergency care from delayed PA costs 3-5x original service",
        "Provider abrasion from manual PA processing"
      ]
    },

    "enrollment_billing": {
      "formula": "daily_premium_revenue × operational_risk_multiplier",
      "transaction_volume": {
        "value": 1000000,
        "unit": "dollars/day (premium revenue)",
        "source": "Payer financial statements",
        "confidence": 0.9,
        "methodology": "Annual premium revenue / 365 days"
      },
      "calculation": "$1,000,000/day premium × 10% outage impact = $100,000/day",
      "estimated_value": 100000,
      "range": {
        "low": 50000,
        "high": 500000
      },
      "confidence": 0.6,
      "notes": [
        "Most enrollment/billing is batch-processed (not daily)",
        "Outage = delayed enrollments = coverage gaps = member complaints",
        "Premium collection delays = cash flow impact",
        "Regulatory penalties for enrollment timing violations"
      ]
    },

    "member_services": {
      "formula": "call_volume × (call_cost + abandoned_call_cost)",
      "transaction_volume": {
        "value": 10000,
        "unit": "calls/day",
        "source": "Call center metrics",
        "confidence": 0.9,
        "methodology": "Average call volume for medium payer"
      },
      "transaction_value": {
        "component": "per_call_impact",
        "call_handling_cost": {
          "value": 5,
          "unit": "dollars/call",
          "source": "Call center cost allocation",
          "confidence": 0.8
        },
        "escalated_call_cost": {
          "value": 50,
          "unit": "dollars/escalated_call",
          "source": "Supervisor time + complaint handling",
          "confidence": 0.7,
          "escalation_rate": "20% of calls during outage"
        },
        "abandonment_cost": {
          "value": 20,
          "unit": "dollars/abandoned_call",
          "source": "Member dissatisfaction + regulatory risk",
          "confidence": 0.6,
          "abandonment_rate": "30% during outage"
        }
      },
      "calculation": "10,000 calls/day × ($5 base + $10 outage premium) = $150,000/day",
      "estimated_value": 150000,
      "range": {
        "low": 75000,
        "high": 500000
      },
      "confidence": 0.6,
      "notes": [
        "System outage = call volume spike (50-100% increase)",
        "Higher abandonment = member complaints = regulatory risk",
        "Manual workaround costs (overtime, temporary staff)"
      ]
    },

    "provider_management": {
      "formula": "new_provider_enrollments × enrollment_cost + directory_penalty_risk",
      "transaction_volume": {
        "value": 100,
        "unit": "new provider enrollments/week",
        "source": "Provider enrollment tracking",
        "confidence": 0.8,
        "methodology": "New provider contracts per week / 5 days"
      },
      "transaction_value": {
        "component": "per_enrollment_impact",
        "delayed_enrollment_cost": {
          "value": 5000,
          "unit": "dollars/enrollment",
          "source": "Provider administrative time + lost claims during delay",
          "confidence": 0.7,
          "breakdown": "Provider admin time ($2,000) + Claims delay impact ($3,000)"
        },
        "directory_penalty_risk": {
          "value": 100000,
          "unit": "dollars/day (potential)",
          "source": "State insurance department penalties",
          "confidence": 0.5,
          "note": "Only if directory inaccuracies occur due to outage"
        }
      },
      "calculation": "20 enrollments/day × $5,000/enrollment = $100,000/day",
      "estimated_value": 100000,
      "range": {
        "low": 25000,
        "high": 500000
      },
      "confidence": 0.6,
      "notes": [
        "Most provider management is not time-critical (lower daily impact)",
        "Main risk = network adequacy violations if directory updates fail",
        "Provider abrasion from delayed enrollment/recredentialing"
      ]
    },

    "pharmacy_benefits": {
      "formula": "pharmacy_claims_volume × (claim_delay_cost + patient_safety_risk)",
      "transaction_volume": {
        "value": 15000,
        "unit": "pharmacy claims/day",
        "source": "PBM claims processing data",
        "confidence": 0.9,
        "methodology": "Total pharmacy claims / 365 days"
      },
      "transaction_value": {
        "value": 150,
        "unit": "dollars/claim",
        "source": "Average pharmacy claim reimbursement",
        "confidence": 0.8,
        "breakdown": "Drug cost ($120) + Dispensing fee ($30)"
      },
      "calculation": "15,000 claims/day × $150/claim = $2,250,000/day",
      "estimated_value": 2250000,
      "range": {
        "low": 1000000,
        "high": 5000000
      },
      "confidence": 0.8,
      "primary_benchmark": "Change Healthcare pharmacy outage impact",
      "impact_components": {
        "patient_access": "Patients unable to fill prescriptions = health risk",
        "pharmacy_cash_flow": "Independent pharmacies operate on thin margins",
        "specialty_drugs": "High-cost specialty drugs ($1,000-$10,000) create critical impact",
        "rebate_impact": "Manufacturer rebate processing delays"
      },
      "notes": [
        "Pharmacy outage = patient safety issue (medication adherence)",
        "High-cost specialty drugs magnify impact",
        "Many pharmacies will provide drugs with promise of payment (cash flow risk)"
      ]
    },

    "analytics_reporting": {
      "formula": "reporting_delay_risk × regulatory_penalty_exposure",
      "transaction_volume": {
        "value": 0,
        "unit": "daily_reports",
        "source": "Regulatory reporting calendar",
        "confidence": 0.9,
        "methodology": "Most reporting is monthly/quarterly, not daily"
      },
      "calculation": "No daily impact (process is batch, not real-time)",
      "estimated_value": 10000,
      "range": {
        "low": 0,
        "high": 1000000
      },
      "confidence": 0.4,
      "notes": [
        "Most analytics/reporting is not time-critical (low daily impact)",
        "Risk = missed regulatory deadlines (MLR, HEDIS, STARs)",
        "Penalties = $50K-$500K per violation (not daily)",
        "Impact spikes at quarter-end/month-end reporting periods"
      ],
      "seasonal_spike": {
        "event": "Quarterly reporting deadlines",
        "daily_impact": 250000,
        "duration": "5-10 business days",
        "note": "Analytics outage during reporting window = regulatory penalty risk"
      }
    },

    "care_management": {
      "formula": "care_interventions × intervention_cost",
      "transaction_volume": {
        "value": 500,
        "unit": "care interventions/day",
        "source": "Care management program metrics",
        "confidence": 0.8,
        "methodology": "Case manager encounters + outreach calls"
      },
      "transaction_value": {
        "value": 200,
        "unit": "dollars/intervention",
        "source": "Case manager cost allocation",
        "confidence": 0.7,
        "breakdown": "Case manager time ($150) + Program overhead ($50)"
      },
      "calculation": "500 interventions/day × $200/intervention = $100,000/day",
      "estimated_value": 100000,
      "range": {
        "low": 25000,
        "high": 500000
      },
      "confidence": 0.5,
      "notes": [
        "Care management delays = adverse health events (long-term impact)",
        "Not immediately time-critical (lower daily impact)",
        "Main risk = readmission penalties from missed interventions"
      ],
      "long_term_impact": {
        "description": "Delayed care management = higher costs later",
        "example": "Missed CHF follow-up = hospital readmission ($15K)",
        "time_horizon": "30-90 days to see impact",
        "confidence": 0.6
      }
    },

    "compliance_audit": {
      "formula": "audit_delay_risk × penalty_exposure",
      "transaction_volume": {
        "value": 0,
        "unit": "daily_audits",
        "source": "Audit calendar",
        "confidence": 0.9,
        "methodology": "Audits are scheduled, not daily"
      },
      "calculation": "No daily operational impact (support function, not transactional)",
      "estimated_value": 5000,
      "range": {
        "low": 0,
        "high": 5000000
      },
      "confidence": 0.3,
      "notes": [
        "Compliance is not a high-volume transaction process",
        "Risk = missed audit deadlines = massive penalties ($1M-$10M)",
        "Impact occurs if outage prevents audit response (not daily)"
      ],
      "catastrophic_risk": {
        "event": "OCR audit missed deadline",
        "potential_penalty": "Up to $1.75M annual HIPAA penalty",
        "probability": "Low (<1%/year)",
        "daily_risk_value": "5000/day (annualized penalty / 365)"
      }
    }
  },

  "ui_requirements": {
    "rendering_mandates": {
      "always_render_source": true,
      "always_render_assumptions": true,
      "show_confidence": true,
      "never_hide_calculations": true,
      "display_edit_button": true,
      "show_last_reviewed_date": true
    },

    "component_specification": {
      "component_name": "DowntimeCostDisplay",
      "required_props": ["processId", "downtimeCost"],
      "required_sections": [
        "cost_estimate_display",
        "source_attribution",
        "assumptions_list",
        "calculation_breakdown",
        "confidence_indicator",
        "range_display",
        "edit_controls"
      ]
    },

    "jsx_template": {
      "description": "Reference implementation for rendering downtime cost with full transparency",
      "code_template": `
// DowntimeCostDisplay.jsx - Reference Implementation
import React, { useState } from 'react';

const DowntimeCostDisplay = ({ processId, downtimeCost, onEdit }) => {
  const [showDetails, setShowDetails] = useState(true);

  if (!downtimeCost) {
    return (
      <div className="downtime-cost-placeholder">
        <p>No downtime cost estimate available</p>
        <button onClick={() => onEdit(processId)}>
          Add Cost Estimate
        </button>
      </div>
    );
  }

  const {
    estimated_value,
    currency,
    source,
    assumptions,
    calculation,
    confidence,
    range,
    last_reviewed,
    review_frequency,
    notes
  } = downtimeCost;

  const getConfidenceLabel = (conf) => {
    if (conf >= 0.8) return { label: 'High', color: '#10B981' };
    if (conf >= 0.6) return { label: 'Medium', color: '#F59E0B' };
    return { label: 'Low', color: '#EF4444' };
  };

  const confidenceMeta = getConfidenceLabel(confidence);

  return (
    <div className="downtime-cost-container">
      {/* Primary Cost Estimate - ALWAYS VISIBLE */}
      <div className="cost-header">
        <h3>Downtime Cost Impact</h3>
        <button
          className="edit-button"
          onClick={() => onEdit(processId, downtimeCost)}
          aria-label="Edit downtime cost assumptions"
        >
          Edit Assumptions
        </button>
      </div>

      <div className="cost-estimate">
        <span className="value">
          {currency} {estimated_value.toLocaleString()}
        </span>
        <span className="unit">per day</span>
        <div
          className="confidence-badge"
          style={{ backgroundColor: confidenceMeta.color }}
          title={\`Confidence: \${Math.round(confidence * 100)}%\`}
        >
          {confidenceMeta.label} Confidence
        </div>
      </div>

      {/* Range Display */}
      {range && (
        <div className="cost-range">
          <span className="range-label">Estimated Range:</span>
          <span className="range-low">
            {currency} {range.low.toLocaleString()}
          </span>
          <span className="range-separator">—</span>
          <span className="range-high">
            {currency} {range.high.toLocaleString()}
          </span>
        </div>
      )}

      {/* SOURCE ATTRIBUTION - NEVER HIDE */}
      <div className="source-attribution">
        <span className="label">Source:</span>
        {source.url ? (
          <a
            href={source.url}
            target="_blank"
            rel="noopener noreferrer"
            className="source-link"
          >
            {source.citation}
            <span className="external-link-icon">↗</span>
          </a>
        ) : (
          <span className="source-text">{source.citation}</span>
        )}
        {source.organization && (
          <span className="source-org">({source.organization})</span>
        )}
        <div className="source-type">
          Type: {source.type.replace(/_/g, ' ')}
        </div>
      </div>

      {/* CALCULATION - ALWAYS SHOW */}
      <div className="calculation">
        <span className="label">Calculation:</span>
        <code className="formula">{calculation}</code>
      </div>

      {/* ASSUMPTIONS - NEVER HIDE */}
      <div className="assumptions">
        <span className="label">Assumptions:</span>
        <ul className="assumptions-list">
          {assumptions.map((assumption, index) => (
            <li key={index} className="assumption-item">
              <span className="assumption-text">
                {assumption.assumption}
              </span>
              <div className="assumption-meta">
                <span className="assumption-source">
                  Source: {assumption.source}
                </span>
                <span
                  className="assumption-confidence"
                  title={\`Confidence: \${Math.round(assumption.confidence * 100)}%\`}
                >
                  ({Math.round(assumption.confidence * 100)}% confidence)
                </span>
              </div>
            </li>
          ))}
        </ul>
      </div>

      {/* ADDITIONAL NOTES */}
      {notes && (
        <div className="notes">
          <span className="label">Notes:</span>
          <p className="notes-text">{notes}</p>
        </div>
      )}

      {/* METADATA */}
      <div className="cost-metadata">
        <span className="last-reviewed">
          Last reviewed: {new Date(last_reviewed).toLocaleDateString()}
        </span>
        <span className="review-frequency">
          Review: {review_frequency.replace(/-/g, ' ')}
        </span>
      </div>

      {/* EXPAND DETAILS (optional toggle) */}
      {showDetails && (
        <div className="cost-details">
          <button
            className="toggle-details"
            onClick={() => setShowDetails(!showDetails)}
          >
            {showDetails ? 'Hide' : 'Show'} Full Details
          </button>
        </div>
      )}
    </div>
  );
};

export default DowntimeCostDisplay;
`
    },

    "styling_guidelines": {
      "cost_estimate": {
        "font_size": "2rem",
        "font_weight": "bold",
        "color": "#1F2937",
        "margin": "1rem 0"
      },
      "source_attribution": {
        "font_size": "0.875rem",
        "color": "#6B7280",
        "link_color": "#2563EB",
        "margin": "0.5rem 0"
      },
      "assumptions": {
        "font_size": "0.875rem",
        "background_color": "#F9FAFB",
        "padding": "0.75rem",
        "border_radius": "0.375rem",
        "margin": "1rem 0"
      },
      "confidence_indicator": {
        "high_confidence": "#10B981 (green)",
        "medium_confidence": "#F59E0B (amber)",
        "low_confidence": "#EF4444 (red)",
        "display": "badge with percentage"
      },
      "edit_button": {
        "position": "top-right",
        "variant": "outline",
        "icon": "pencil/edit icon"
      }
    }
  },

  "api_endpoints": {
    "get_downtime_cost": {
      "method": "GET",
      "path": "/api/processes/:processId/downtime-cost",
      "description": "Retrieve downtime cost estimate for a specific process",
      "response": {
        "process_id": "string",
        "downtime_cost_per_day": {
          "estimated_value": "number",
          "currency": "string",
          "source": { "type", "citation", "url", "organization" },
          "assumptions": [{ "assumption", "source", "confidence" }],
          "calculation": "string",
          "confidence": "number",
          "range": { "low", "high" },
          "last_reviewed": "date",
          "review_frequency": "string"
        }
      }
    },

    "update_downtime_cost": {
      "method": "PUT",
      "path": "/api/processes/:processId/downtime-cost",
      "description": "Update downtime cost estimate with new assumptions or calculations",
      "request_body": {
        "estimated_value": "number (required)",
        "currency": "string (default: USD)",
        "source": {
          "type": "string (required)",
          "citation": "string (required)",
          "url": "string (optional)",
          "organization": "string (optional)"
        },
        "assumptions": [
          {
            "assumption": "string (required)",
            "source": "string (required)",
            "confidence": "number (0-1, required)"
          }
        ],
        "calculation": "string (required)",
        "confidence": "number (0-1, required)",
        "range": {
          "low": "number (optional)",
          "high": "number (optional)"
        },
        "notes": "string (optional)"
      },
      "response": {
        "success": "boolean",
        "updated_downtime_cost": { /* full schema */ },
        "previous_version": { /* for audit trail */ }
      }
    },

    "get_benchmarks": {
      "method": "GET",
      "path": "/api/benchmarks",
      "description": "Retrieve all available public benchmarks for reference",
      "response": {
        "benchmarks": { /* public_benchmarks object */ }
      }
    },

    "get_calculation_template": {
      "method": "GET",
      "path": "/api/processes/:processId/calculation-template",
      "description": "Get calculation template for a specific process type",
      "response": {
        "process_id": "string",
        "formula": "string",
        "components": { /* calculation template */ }
      }
    }
  },

  "validation_rules": {
    "source_validation": [
      "Source type must be one of: public_benchmark, industry_report, internal_data, regulatory_filing, actuarial_study",
      "Public sources must include URL",
