  "demo_swap_mechanism": {
    "description": "Support local file override for customer demos",
    "folder_structure": {
      "demo": {
        "customers": {
          "acme-health-plan": {
            "processes.json": "Custom demo data for Acme Health Plan",
            "applications.json": "Custom application inventory for demo"
          },
          "blue-cross-blue-shield": {
            "processes.json": "Custom demo data for BCBS",
            "applications.json": "Custom application inventory for demo"
          }
        }
      },
      "fixtures": {
        "synthetic-payer-1-processes.json": "Synthetic payer 1 fixture data",
        "synthetic-payer-1-applications.json": "Synthetic payer 1 applications",
        "synthetic-payer-2-processes.json": "Synthetic payer 2 fixture data",
        "synthetic-payer-2-applications.json": "Synthetic payer 2 applications"
      }
    },
    "loading_logic": {
      "description": "Priority order for loading payer data",
      "steps": [
        {
          "step": 1,
          "action": "Check local demo folder",
          "path": "demo/customers/{payer_id}/processes.json",
          "priority": "highest",
          "use_case": "Customer-specific demo data override"
        },
        {
          "step": 2,
          "action": "Fall back to synthetic fixtures",
          "path": "fixtures/synthetic-{payer_id}-processes.json",
          "priority": "default",
          "use_case": "Development and testing"
        },
        {
          "step": 3,
          "action": "Return empty dataset error",
          "error": "No fixture data found for payer_id: {payer_id}",
          "priority": "fallback"
        }
      ]
    },
    "implementation_example": {
      "language": "JavaScript/Node.js",
      "code": "const loadPayerData = (payerId) => {\n  // 1. Check local demo folder first\n  const demoPath = path.join(__dirname, '../../demo/customers', payerId, 'processes.json');\n  if (fs.existsSync(demoPath)) {\n    console.log(`Loading demo data for ${payerId} from ${demoPath}`);\n    return JSON.parse(fs.readFileSync(demoPath, 'utf8'));\n  }\n  \n  // 2. Fall back to synthetic fixtures\n  const fixturePath = path.join(__dirname, '../../fixtures', `synthetic-${payerId}-processes.json`);\n  if (fs.existsSync(fixturePath)) {\n    console.log(`Loading fixture data for ${payerId} from ${fixturePath}`);\n    return JSON.parse(fs.readFileSync(fixturePath, 'utf8'));\n  }\n  \n  // 3. No data found\n  throw new Error(`No fixture data found for payer_id: ${payerId}`);\n};"
    }
  },
