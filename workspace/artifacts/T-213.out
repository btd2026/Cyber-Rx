{
  "version": "1.0.0",
  "task_id": "T-213",
  "title": "Match API + Synthetic Payer Fixtures",
  "created_at": "2025-06-03T16:00:00Z",
  "api_endpoints": {
    "POST /api/match/processes": {
      "description": "Match canonical customer processes to reference model using T-212 matcher",
      "authentication": "Bearer JWT (required)",
      "request_body": {
        "canonical_rows": {
          "type": "array",
          "description": "Canonical process rows from T-211 normalization",
          "items": {
            "row_id": "string (UUID)",
            "process_name": "string",
            "application_name": "string (optional)",
            "criticality": "string (optional)",
            "owner": "string (optional)",
            "description": "string (optional)",
            "provenance": {
              "normalization_confidence": "float (0-1)",
              "source": "string"
            }
          }
        },
        "match_options": {
          "type": "object",
          "optional": true,
          "properties": {
            "use_llm": {
              "type": "boolean",
              "default": true,
              "description": "Enable LLM-assisted semantic matching"
            },
            "confidence_threshold": {
              "type": "float",
              "default": 0.7,
              "description": "Minimum confidence for proposal acceptance"
            },
            "max_candidates": {
              "type": "integer",
              "default": 3,
              "description": "Maximum candidate matches per entity"
            },
            "payer_context": {
              "type": "string",
              "optional": true,
              "description": "Payer ID for context-aware matching (Commercial, Medicare, Medicaid)"
            }
          }
        }
      },
      "response_success": {
        "status": 200,
        "body": {
          "match_id": "uuid-v4",
          "status": "complete",
          "created_at": "ISO 8601 timestamp",
          "summary": {
            "total_rows": 150,
            "matched": 135,
            "unmatched": 15,
            "requires_review": 150,
            "high_confidence": 90,
            "medium_confidence": 45,
            "low_confidence": 15
          },
          "proposals": [
            {
              "row_id": "row-uuid-001",
              "customer_data": {
                "process_name": "Claims Processing",
                "application_name": "Facets",
                "criticality": "high"
              },
              "proposed_mappings": [
                {
                  "entity_type": "process",
                  "reference_id": "claims-adjudication",
                  "reference_name": "Claims Adjudication",
                  "confidence": 0.92,
                  "method": "llm_assisted",
                  "rationale": "LLM identified semantic equivalence: 'Claims Processing' and 'Claims Adjudication' both describe claims evaluation workflow. Same domain (claims), similar terminology.",
                  "requires_review": true,
                  "review_priority": "medium",
                  "provenance": {
                    "normalization_confidence": 0.95,
                    "matching_timestamp": "2025-06-03T16:00:00Z"
                  }
                },
                {
                  "entity_type": "application",
                  "reference_id": "claims-adjudication-system",
                  "reference_name": "Claims Adjudication System",
                  "confidence": 0.95,
                  "method": "vendor_match",
                  "rationale": "Exact vendor match: 'Facets' is a typical vendor for claims-adjudication-system per reference model.",
                  "requires_review": true,
                  "review_priority": "low"
                }
              ],
              "unmatched_entities": [],
              "warnings": []
            }
          ],
          "unmatched_rows": [
            {
              "row_id": "row-uuid-099",
              "customer_data": {
                "process_name": "Custom Legacy Process",
                "application_name": "Unknown App"
              },
              "unmatched_entities": [
                {
                  "entity_type": "process",
                  "customer_value": "Custom Legacy Process",
                  "reason": "No semantic match in reference model",
                  "suggested_action": "Add to reference model as custom process or mark as outlier",
                  "potential_candidates": [
                    {"id": "claims-adjudication", "confidence": 0.35},
                    {"id": "enrollment-and-billing", "confidence": 0.28}
                  ]
                }
              ]
            }
          ]
        }
      },
      "response_errors": {
        "400": {"error": "invalid_request", "message": "Missing required fields in request body"},
        "401": {"error": "unauthorized", "message": "Invalid or missing JWT token"},
        "404": {"error": "reference_model_not_loaded", "message": "Reference model (T-204) not available"},
        "422": {"error": "validation_error", "message": "Canonical rows missing required process_id or process_name"},
        "500": {"error": "matching_failure", "message": "Internal error during matching process"},
        "503": {"error": "llm_service_unavailable", "message": "LLM service unavailable, using deterministic fallback"}
      }
    },
    "GET /api/match/:match_id": {
      "description": "Retrieve match results by ID",
      "authentication": "Bearer JWT (required)",
      "parameters": {
        "path": [
          {
            "name": "match_id",
            "type": "UUID",
            "required": true,
            "description": "Match ID from POST /api/match/processes response"
          }
        ]
      },
      "response_success": {
        "status": 200,
        "body": {
          "match_id": "uuid-v4",
          "created_at": "2025-06-03T16:00:00Z",
          "status": "complete",
          "proposals": [...],
          "summary": {...}
        }
      },
      "response_errors": {
        "401": {"error": "unauthorized", "message": "Invalid or missing JWT token"},
        "404": {"error": "match_not_found", "message": "Match ID not found or expired"}
      }
    },
    "GET /api/match/status/:match_id": {
      "description": "Check processing status for long-running matches",
      "authentication": "Bearer JWT (required)",
      "response_success": {
        "status": 200,
        "body": {
          "match_id": "uuid-v4",
          "status": "processing|complete|failed",
          "progress": {
            "total": 150,
            "processed": 75,
            "percentage": 50
          },
          "estimated_completion": "2025-06-03T16:05:00Z"
        }
      }
    }
  },
  "reference_model_query_endpoints": {
    "description": "Query endpoints for reference model (T-204) - design documented, implementation deferred",
    "endpoints": [
      {
        "method": "GET",
        "path": "/api/reference-model/processes",
        "description": "List all processes from reference model",
        "response": {"processes": [...], "total": 10}
      },
      {
        "method": "GET",
        "path": "/api/reference-model/processes/:id",
        "description": "Get specific process by ID",
        "response": {"process": {...}}
      },
      {
        "method": "GET",
        "path": "/api/reference-model/applications",
        "description": "List all applications from reference model",
        "parameters": {"criticality": "crown-jewel|high|medium"},
        "response": {"applications": [...], "total": 13}
      },
      {
        "method": "GET",
        "path": "/api/reference-model/applications/:id",
        "description": "Get specific application by ID",
        "response": {"application": {...}}
      },
      {
        "method": "GET",
        "path": "/api/reference-model/risks",
        "description": "List all risks with filtering",
        "parameters": {"severity": "critical|high|medium|low", "category": "operational|security|financial|compliance"},
        "response": {"risks": [...], "total": 58}
      },
      {
        "method": "GET",
        "path": "/api/reference-model/risks?process_id=:process_id",
        "description": "Get risks for specific process",
        "response": {"risks": [...], "process_id": "claims-adjudication"}
      },
      {
        "method": "GET",
        "path": "/api/reference-model/controls",
        "description": "List all controls",
        "parameters": {"framework": "HIPAA Security Rule|HITRUST CSF"},
        "response": {"controls": [...], "total": 8}
      },
      {
        "method": "GET",
        "path": "/api/reference-model/search?q=:query",
        "description": "Full-text search across all entities",
        "response": {"results": [...], "total": 50}
      }
    ]
  },
