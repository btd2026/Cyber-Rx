  "application_archetypes": [
    {
      "id": "claims-adjudication-system",
      "name": "Claims Adjudication System",
      "description": "Core system that processes medical claims through business rules to determine payment eligibility and amounts. The heartbeat of payer operations.",
      "supported_processes": [
        "claims-adjudication",
        "payment-processing",
        "claims-auto-adjudication",
        "claims-manual-review"
      ],
      "typical_vendors": [
        "Change Healthcare (formerly McKesson)",
        "Optum (UnitedHealth Group)",
        "Cognizant (TriZetto Facets, QNXT)",
        "Guidewire (for property/casualty extending to health)",
        "HealthEdge (HealthRules)",
        "MCS (icare, e-Maxx)",
        "Edifecs (claims processing suite)"
      ],
      "criticality": "crown-jewel",
      "typical_risks": [
        "Outage halts all claims processing - revenue impact",
        "Data breach exposes massive PHI datasets",
        "Adjudication logic errors cause payment leaks or denials",
        "System latency creates provider payment backlogs"
      ],
      "x12_transactions": ["837", "835"],
      "typical_users": ["Claims Analysts", "Payment Operations", "Claims Managers"]
    },
