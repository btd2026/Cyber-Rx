{
  "version": "1.0-draft",
  "status": "expert-review-pending",
  "disclaimer": "NOT CERTIFIED COMPLIANCE GUIDANCE. This is a draft control mapping for reference only. Requires certified compliance expert review before production use. Do not rely on this for regulatory compliance decisions.",
  "metadata": {
    "created_date": "2025-01-31",
    "purpose": "HIPAA/HITRUST control mapping to healthcare-payer crown-jewel process risks",
    "framework_references": {
      "hipaa_security_rule": "45 CFR §164.312 (Technical Safeguards)",
      "hitrust_csf": "HITRUST CSF v9.8",
      "integration_targets": ["AuditBoard", "Archer", "ServiceNow GRC"]
    },
    "source_authority": {
      "hipaa": "https://www.ecfr.gov/current/title-45/section-164.312",
      "hitrust": "https://hitrust.org/hitrust-csf/"
    }
  },
  "control_frameworks": {
    "hipaa_security_rule_summary": {
      "access_control": {
        "control_id": "164.312(a)(1)",
        "title": "Access Control",
        "requirements": "Unique user identification, emergency access procedure, automatic logoff, encryption and decryption",
        "relevant_risks": ["All PHI access risks", "Insider threats", "Credential theft"]
      },
      "audit_controls": {
        "control_id": "164.312(b)",
        "title": "Audit Controls",
        "requirements": "Mechanisms to record and examine activity in information systems that contain or use PHI",
        "relevant_risks": ["Fraud detection", "Insider threats", "Data breaches"]
      },
      "integrity": {
        "control_id": "164.312(c)(1)",
        "title": "Integrity",
        "requirements": "Mechanisms to protect PHI from improper alteration or destruction",
        "relevant_risks": ["Data corruption", "Claims manipulation", "Configuration errors"]
      },
      "transmission_security": {
        "control_id": "164.312(e)(1)",
        "title": "Transmission Security",
        "requirements": "Encryption of PHI in transit, integrity controls",
        "relevant_risks": ["EDI interception", "Data in transit breaches", "API security"]
      },
      "authentication": {
        "control_id": "164.312(d)",
        "title": "Person or Entity Authentication",
        "requirements": "Verify identity of entities accessing PHI",
        "relevant_risks": ["Credential theft", "Unauthorized access", "Impersonation"]
      }
    },
    "hitrust_csf_summary": {
      "access_control": {
        "control_id": "06.a",
        "title": "Access Control",
        "requirements": "System access, privilege management, access review",
        "relevant_risks": ["Unauthorized access", "Privilege escalation", "Insider threats"]
      },
      "security_awareness": {
        "control_id": "06.e",
        "title": "Security Awareness and Training",
        "requirements": "Training programs, phishing simulations, security awareness",
        "relevant_risks": ["Phishing", "Social engineering", "Credential theft"]
      },
      "phi_access_management": {
        "control_id": "09.a",
        "title": "Protected Health Information (PHI) Access Management",
        "requirements": "Role-based access, minimum necessary, access authorization",
        "relevant_risks": ["PHI breaches", "Unauthorized disclosure", "Access violations"]
      },
      "encryption": {
        "control_id": "10.d",
        "title": "Encryption and Decryption",
        "requirements": "Encryption at rest and in transit, key management",
        "relevant_risks": ["Data breaches", "PHI exposure", "Loss of devices"]
      },
      "business_associate_management": {
        "control_id": "11.b",
        "title": "Business Associate Management",
        "requirements": "BA agreements, vendor risk management, third-party oversight",
        "relevant_risks": ["Vendor data breaches", "Third-party failures", "Supply chain attacks"]
      },
      "incident_management": {
        "control_id": "10.e",
        "title": "Incident Response and Management",
        "requirements": "Incident response plan, breach detection, notification procedures",
        "relevant_risks": ["Ransomware", "Data breaches", "Security incidents"]
      },
      "business_continuity": {
        "control_id": "10.a",
        "title": "Business Continuity and Disaster Recovery",
        "requirements": "BC/DR planning, testing, recovery procedures",
        "relevant_risks": ["System outages", "Disaster recovery", "RTO/RPO violations"]
      }
    }
  },
  "grc_integration_patterns": {
    "auditboard": {
      "control_library_path": "Control Library > HIPAA Security Rule > {Control Category}",
      "mapping_field": "Custom Attribute > Risk ID",
      "test_procedure": "Testing > Automated Tests > Risk Control Test",
      "reporting": "Reports > Risk & Control > Risk Control Matrix"
    },
    "archer": {
      "control_library_path": "HIPAA Security Rule > Technical Safeguards > {Control ID}",
      "mapping_field": "Risk Mapping > Risk Record",
      "test_procedure": "Exams > Control Assessments > Link to Risks",
      "reporting": "Reports > Risk Control Alignment > Risk Control Heat Map"
    },
    "servicenow": {
      "control_library_path": "GRC > Controls > HIPAA > Technical Safeguards",
      "mapping_field": "Control > Related Risks",
      "test_procedure": "Assessments > Control Tests > Automated Test Scripts",
      "reporting": "GRC > Reports > Risk Control Mapping > Executive Summary"
    }
  },
  "control_mappings": [
    {
      "risk_id": "claims-outage",
      "risk_title": "Claims Adjudication System Outage",
      "hipaa_controls": [
        {
          "control_id": "164.312(a)(1)",
          "title": "Access Control - Emergency Access Procedure",
          "relevant_sections": ["Emergency access", "Contingency operations"],
          "implementation_guidance": "Document emergency access procedures for claims system outage. Ensure emergency access is logged and time-limited. Maintain offline capability for urgent claims."
        }
      ],
      "hitrust_controls": [
        {
          "control_id": "10.a",
          "title": "Business Continuity and Disaster Recovery",
          "implementation_guidance": "Implement disaster recovery site with <4 hour RTO for claims system. Document and test failover procedures. Maintain backup adjudication capability."
        },
        {
          "control_id": "06.a",
          "title": "Access Control - Emergency Access",
          "implementation_guidance": "Establish emergency access procedures for claims adjudicators during outages. Ensure emergency access is audited and approved."
        }
      ],
      "grc_integration": {
        "auditboard": "Control Library > HIPAA > Contingency Plan > Emergency Access",
        "archer": "HIPAA Security Rule > 164.312(a)(1) - Emergency Access",
        "servicenow": "GRC > Controls > HIPAA > Contingency Planning > Emergency Mode"
      }
    },
    {
      "risk_id": "claims-data-corruption",
      "risk_title": "Claims Database Corruption",
      "hipaa_controls": [
        {
          "control_id": "164.312(c)(1)",
          "title": "Integrity - Mechanisms to Protect PHI",
          "relevant_sections": ["Data integrity", "Improper alteration protection"],
          "implementation_guidance": "Implement immutable audit trails for claims records. Use database integrity checks and validation. Maintain transaction logs with rollback capability."
        }
      ],
      "hitrust_controls": [
        {
          "control_id": "10.d",
          "title": "Encryption and Decryption - Data Integrity",
          "implementation_guidance": "Implement cryptographic validation of database integrity. Use digital signatures for critical claims records. Maintain automated backup verification."
        },
        {
          "control_id": "11.a",
          "title": "Data Backup and Recovery",
          "implementation_guidance": "Automated backup verification with regular testing. Maintain multiple recovery points. Document backup restoration procedures."
        }
      ],
      "grc_integration": {
        "auditboard": "Control Library > HIPAA > Integrity Controls > Data Validation",
        "archer": "HIPAA Security Rule > 164.312(c)(1) - Integrity Mechanisms",
        "servicenow": "GRC > Controls > HIPAA > Technical Safeguards > Data Integrity"
      }
    },
    {
      "risk_id": "claims-ransomware",
      "risk_title": "Claims Adjudication Ransomware Attack",
      "hipaa_controls": [
        {
          "control_id": "164.312(a)(1)",
          "title": "Access Control - Authentication and Access",
          "relevant_sections": ["Unique user identification", "Authentication"],
          "implementation_guidance": "Implement zero-trust access controls for claims systems. Use MFA for all access. Segment network to prevent ransomware spread."
        },
        {
          "control_id": "164.312(e)(1)",
          "title": "Transmission Security - Encryption",
          "relevant_sections": ["Encryption of PHI", "Integrity controls"],
          "implementation_guidance": "Encrypt all claims data at rest and in transit. Use immutable backups that cannot be encrypted by ransomware."
        }
      ],
      "hitrust_controls": [
        {
          "control_id": "10.e",
          "title": "Incident Response and Management",
          "implementation_guidance": "Implement ransomware-specific incident response plan. Conduct tabletop exercises. Establish isolation procedures for infected systems."
        },
        {
          "control_id": "10.d",
          "title": "Encryption - Immutable Backups",
          "implementation_guidance": "Maintain offline, immutable backups. Test backup restoration quarterly. Implement backup segmentation."
        },
        {
          "control_id": "06.a",
          "title": "Access Control - Zero Trust",
          "implementation_guidance": "Implement least-privilege access. Use endpoint detection and response (EDR). Regular access review and revocation."
        }
      ],
      "grc_integration": {
        "auditboard": "Control Library > HIPAA > Incident Response > Ransomware",
        "archer": "HIPAA Security Rule > Incident Management > Ransomware Response",
        "servicenow": "GRC > Controls > HIPAA > Incident Response > Malware Protection"
      }
    },
    {
      "risk_id": "claims-fraud-engineering-access",
      "risk_title": "Fraudulent Claims Processing via Insider Access",
      "hipaa_controls": [
        {
          "control_id": "164.312(a)(1)",
          "title": "Access Control - Unique User Identification",
          "relevant_sections": ["User identification", "Access tracking"],
          "implementation_guidance": "Implement role-based access control with least privilege. Use unique user credentials for all claims system access. Separate duties for high-value transactions."
        },
        {
          "control_id": "164.312(b)",
          "title": "Audit Controls",
          "relevant_sections": ["Activity recording", "Audit examination"],
          "implementation_guidance": "Comprehensive audit logging of all claims transactions. Implement behavioral analytics for anomaly detection. Regular audit log review."
        }
      ],
      "hitrust_controls": [
        {
          "control_id": "06.a",
          "title": "Access Control - Privilege Management",
          "implementation_guidance": "Implement separation of duties. Regular access reviews for claims adjudicators. Behavioral monitoring for fraud detection."
        },
        {
          "control_id": "09.a",
          "title": "PHI Access Management",
          "implementation_guidance": "Role-based access for claims adjudicators. Access recertification quarterly. Mandatory vacation rotation for high-privilege users."
        }
      ],
      "grc_integration": {
        "auditboard": "Control Library > HIPAA > Access Control > Insider Threat",
        "archer": "HIPAA Security Rule > 164.312(a)(1) - Access Control",
        "servicenow": "GRC > Controls > HIPAA > Access Control > User Access Review"
      }
    },
    {
      "risk_id": "claims-config-error",
