          "implementation_guidance": "Implement multi-factor authentication (MFA) for claims system access. Conditional access policies based on risk factors."
        },
        {
          "control_id": "164.312(b)",
          "title": "Audit Controls - Session Monitoring",
          "relevant_sections": ["Activity recording", "Session monitoring"],
          "implementation_guidance": "Session monitoring and anomaly detection. Alert on unusual access patterns. Regular security awareness training."
        }
      ],
      "hitrust_controls": [
        {
          "control_id": "06.e",
          "title": "Security Awareness and Training",
          "implementation_guidance": "Conduct phishing simulation exercises. Security awareness training for all claims system users. Reporting mechanisms for suspicious emails."
        },
        {
          "control_id": "06.a",
          "title": "Access Control - MFA",
          "implementation_guidance": "Enforce MFA for all claims system access. Implement risk-based authentication. Regular password security policies."
        }
      ],
      "grc_integration": {
        "auditboard": "Control Library > HIPAA > Security Awareness > Phishing",
        "archer": "HIPAA Security Rule > 164.312(d) - Authentication > MFA",
        "servicenow": "GRC > Controls > HIPAA > Security Training > Phishing Awareness"
      }
    },
    {
      "risk_id": "edi-outage",
      "risk_title": "EDI Gateway Complete Outage",
      "hipaa_controls": [
        {
          "control_id": "164.312(a)(1)",
          "title": "Access Control - Emergency Access",
          "relevant_sections": ["Contingency operations"],
