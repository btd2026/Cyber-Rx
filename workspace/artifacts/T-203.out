      ],
      "hitrust_controls": [
        {
          "control_id": "10.a",
          "title": "Business Continuity and Disaster Recovery",
          "implementation_guidance": "Redundant EDI gateway with automatic failover. Queue-based processing with persistence. Document manual fallback procedures."
        },
        {
          "control_id": "11.b",
          "title": "Business Associate Management - Vendor Continuity",
          "implementation_guidance": "Vendor SLA with financial penalties for outages. Alternative clearinghouse contracts. Regular DR testing with EDI vendors."
        }
      ],
      "grc_integration": {
        "auditboard": "Control Library > HIPAA > Contingency Plan > EDI Continuity",
        "archer": "HIPAA Security Rule > Business Continuity > EDI Redundancy",
