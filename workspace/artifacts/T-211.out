    "confidence_threshold_guidance": {
      "production_recommended": {
        "auto_accept_threshold": 0.85,
        "manual_review_threshold": 0.70,
        "reject_threshold": 0.50
      },
      "testing_recommended": {
        "auto_accept_threshold": 0.95,
        "manual_review_threshold": 0.85,
