      "description": "Data breaches, unauthorized access, ransomware, phishing, insider threats",
      "typical_impact": "HIPAA violations, regulatory fines, reputational damage, legal liability"
    },
    "compliance": {
      "description": "HIPAA violations, regulatory penalties, audit failures, accreditation loss",
      "typical_impact": "Fines, sanctions, contract termination, corporate integrity agreements"
    },
    "strategic": {
      "description": "Vendor lock-in, talent gaps, technical debt, competitive disadvantage",
      "typical_impact": "Long-term viability, market position, innovation capacity"
    }
  },
  "impact_levels": {
    "critical": "Immediate threat to business operations, regulatory compliance, or financial viability",
    "high": "Significant impact on operations, revenue, or regulatory standing",
    "medium": "Moderate impact with workarounds available",
    "low": "Minimal impact with established mitigation procedures"
  },
  "likelihood_levels": {
    "frequent": "Expected to occur multiple times per year",
    "likely": "Expected to occur at least once per year",
    "possible": "May occur once every 2-3 years",
    "unlikely": "Rare event, less than once every 3 years"
  },
