  "appendices": {
    "llm_prompt_examples": {
      "process_matching": {
        "system_prompt": "You are a healthcare payer domain expert. Match customer process names to reference model processes.",
        "user_prompt_template": "Customer Process: \"{{customer_process}}\"\n\nReference Model Processes:\n{{reference_processes}}\n\nReturn JSON with best_match, confidence (0-1), rationale (why this match in healthcare payer context), and alternative_matches with reasons.",
        "example_response": {
          "best_match": "claims-adjudication",
          "confidence": 0.92,
          "rationale": "'Claims Processing' and 'Claims Adjudication' are semantically equivalent in healthcare payer domain. Both describe the systematic evaluation of healthcare claims to determine payment. 'Processing' and 'adjudication' are used interchangeably in industry terminology.",
          "alternative_matches": [
            {"id": "payment-processing", "confidence": 0.35, "reason": "Payment processing is downstream from adjudication, not the same process"}
          ]
        }
