# CyberRx Environment Variables Template
# Copy this file to .env and fill in the values

# ============================================
# APPLICATION SETTINGS
# ============================================
NODE_ENV=production
PORT=3001
APP_VERSION=1.0.0

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cyberrx
DB_USER=cyberrx_user
DB_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://cyberrx_user:your_secure_password_here@localhost:5432/cyberrx

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_URL=redis://localhost:6379

# ============================================
# SECURITY
# ============================================
JWT_SECRET=your_jwt_secret_at_least_32_characters
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=your_refresh_token_secret_at_least_32_characters
REFRESH_TOKEN_EXPIRES_IN=7d

# ============================================
# AWS CONFIGURATION
# ============================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SECRET_ID=cyberrx/credentials

# ============================================
# MONITORING - DATADOG
# ============================================
DATADOG_API_KEY=your_datadog_api_key
DATADOG_APP_KEY=your_datadog_app_key
DATADOG_SITE=datadoghq.com

# ============================================
# ERROR TRACKING - SENTRY
# ============================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id
SENTRY_ENVIRONMENT=production

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# ============================================
# CORS CONFIGURATION
# ============================================
# Comma-separated list of allowed origins for CORS (e.g., https://app.cyberrx.com,https://staging.cyberrx.com)
# In production: Must be explicitly set. Only origins in this list can access the API.
# In development: Localhost origins (3000, 3001, 5173) are always allowed. Add additional origins here.
# CRITICAL: Leave empty in production to enforce strict security. Wildcards are NOT supported.
CORS_ALLOWLIST=

# Optional: Require Origin header for all requests in production (set to 'true' for maximum security)
# When enabled, requests without Origin header (server-to-server, curl) will be rejected
CORS_REQUIRE_ORIGIN=false

# Legacy: Single frontend URL (DEPRECATED - use CORS_ALLOWLIST instead)
# This is still supported for backward compatibility but will be removed in future versions
FRONTEND_URL=http://localhost:5173

# ============================================
# EMAIL CONFIGURATION
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@cyberrx.com

# ============================================
# DEPLOYMENT - VERCEL
# ============================================
VERCEL_TOKEN=your_vercel_token
VERCEL_ORG_ID=your_vercel_org_id
VERCEL_PROJECT_ID=your_vercel_project_id

# ============================================
# DEPLOYMENT - RENDER
# ============================================
RENDER_API_KEY=your_render_api_key
RENDER_SERVICE_ID=your_render_service_id
RENDER_STAGING_SERVICE_ID=your_render_staging_service_id

# ============================================
# NOTIFICATIONS
# ============================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
PAGERDUTY_API_TOKEN=your_pagerduty_api_token
PAGERDUTY_ROUTING_KEY=your_pagerduty_routing_key
PAGERDUTY_API_URL=https://events.pagerduty.com/v2/enqueue

# ============================================
# ALERT SERVICE - SendGrid
# ============================================
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=alerts@cyberrx.com
DEFAULT_ALERT_EMAIL=admin@cyberrx.com

# ============================================
# ALERT SERVICE - Slack Webhooks
# ============================================
SLACK_WEBHOOK_CRITICAL=https://hooks.slack.com/services/YOUR/CRITICAL/WEBHOOK
SLACK_WEBHOOK_WARNING=https://hooks.slack.com/services/YOUR/WARNING/WEBHOOK
SLACK_WEBHOOK_INFO=https://hooks.slack.com/services/YOUR/INFO/WEBHOOK

# ============================================
# FRONTEND URL (for alert links)
# ============================================
FRONTEND_URL=http://localhost:5173

# ============================================
# TESTING
# ============================================
TEST_USER_EMAIL=test@cyberrx.com
TEST_USER_PASSWORD=testpass123

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_NEW_DASHBOARD=false
FEATURE_BETA_FEATURES=false
FEATURE_MAINTENANCE_MODE=false

# ============================================
# FRONTEND (VITE)
# ============================================
VITE_API_URL=https://api.cyberrx.com
VITE_APP_URL=https://app.cyberrx.com
