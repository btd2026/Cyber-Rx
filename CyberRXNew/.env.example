# CyberRx frontend environment variables.
# Copy to `.env` for local dev, and set the same vars in Vercel for deploys.
# All client-exposed vars MUST be prefixed VITE_.

# From Supabase -> Project Settings -> API:
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Edge Functions base URL. Optional — defaults to
# ${VITE_SUPABASE_URL}/functions/v1 when omitted. Set only if you host the
# functions elsewhere.
# VITE_SUPABASE_FUNCTIONS_URL=https://YOUR-PROJECT-ref.supabase.co/functions/v1

# Executive Twin endpoint (server-side Anthropic translator). When unset, the
# Twin answers deterministically client-side (demo, cannot hallucinate).
# VITE_TWIN_URL=https://YOUR-PROJECT-ref.supabase.co/functions/v1/twin

# NOTE: the anon key is meant to be public — Row-Level Security controls access.
# NEVER put the service_role key or the Anthropic API key here. Those are
# server-side only (set as Supabase function secrets, never shipped to browser):
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...   # used by `provision`
#   supabase secrets set ANTHROPIC_API_KEY=...           # used by `twin`
#   supabase secrets set ANTHROPIC_MODEL=claude-sonnet-4-6   # optional
