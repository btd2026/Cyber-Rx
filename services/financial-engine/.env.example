# Financial Modeling Engine Environment Configuration

# ============================================
# KAFKA CONFIGURATION
# ============================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_INPUT_TOPIC=enriched-risk-objects
KAFKA_CONSUMER_GROUP=financial-engine-group
KAFKA_AUTO_OFFSET_RESET=latest
KAFKA_ENABLE_AUTO_COMMIT=true
KAFKA_SESSION_TIMEOUT_MS=30000
KAFKA_HEARTBEAT_INTERVAL_MS=10000

# ============================================
# TIMESCALEDB CONFIGURATION
# ============================================
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432
TIMESCALE_DATABASE=cyberrx
TIMESCALE_USER=cyberrx
TIMESCALE_PASSWORD=cyberrx
TIMESCALE_POOL_SIZE=10
TIMESCALE_MAX_OVERFLOW=20
TIMESCALE_QUERY_TIMEOUT=30

# ============================================
# CALCULATION CONFIGURATION
# ============================================
CALCULATION_METHODOLOGY_VERSION=1.0.0
CALCULATION_TIMEOUT=60
CALCULATION_MAX_RETRIES=3
CALCULATION_BATCH_SIZE=100
CALCULATION_ENABLE_FALLBACK=true
CALCULATION_FALLBACK_MLR_IMPACT=0.01
CALCULATION_FALLBACK_STOP_LOSS_EXPOSURE=100000
CALCULATION_FALLBACK_RESERVE_AT_RISK=150000
CALCULATION_FALLBACK_PREMIUM_REVENUE_RISK=200000

# ============================================
# MLR CALCULATION CONFIGURATION
# ============================================
MLR_DEFAULT_CLAIM_RATE=0.02
MLR_DEFAULT_PREMIUM_REVENUE=1000000
MLR_DEFAULT_AVERAGE_CLAIM_COST=1000
MLR_MIN_MLR_IMPACT=0.0
MLR_MAX_MLR_IMPACT=0.05

# ============================================
# STOP-LOSS CONFIGURATION
# ============================================
STOP_LOSS_DEFAULT_ATTACHMENT=250000
STOP_LOSS_DEFAULT_AGGREGATE=5000000
STOP_LOSS_DEFAULT_CURRENT_POSITION=500000
STOP_LOSS_MIN_EXPOSURE=0.0

# ============================================
# RESERVE CONFIGURATION
# ============================================
RESERVE_DEFAULT_CLAIM_RATE=0.02
RESERVE_DEFAULT_RESERVE_BALANCE=10000000

# ============================================
# PREMIUM REVENUE CONFIGURATION
# ============================================
PREMIUM_REVENUE_DEFAULT_ATTRITION_RATE=0.05
PREMIUM_REVENUE_DEFAULT_PREMIUM_PER_MEMBER=500
PREMIUM_REVENUE_DEFAULT_MEMBER_COUNT=100000

# ============================================
# ACTUARIAL DATA CONFIGURATION
# ============================================
ACTUARIAL_S3_BUCKET=None
ACTUARIAL_S3_PREFIX=actuarial-exports
ACTUARIAL_FTP_HOST=None
ACTUARIAL_FTP_PORT=21
ACTUARIAL_FTP_USERNAME=None
ACTUARIAL_FTP_PASSWORD=None
ACTUARIAL_CSV_DELIMITER=","
ACTUARIAL_CACHE_TTL=3600
ACTUARIAL_DATA_QUALITY_THRESHOLD=0.8

# ============================================
# BATCH SCHEDULING CONFIGURATION
# ============================================
BATCH_FINANCIAL_UPDATE_CRON="0 2 * * *"
BATCH_ACTUARIAL_EXPORT_CRON="0 3 * * *"
BATCH_JOB_TIMEOUT=3600
BATCH_MAX_RETRIES=3
BATCH_RETRY_DELAY=300
BATCH_ENABLE_NOTIFICATIONS=true
BATCH_NOTIFICATION_EMAIL=admin@cyberrx.com

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=None
LOG_ROTATION="100 MB"
LOG_RETENTION="30 days"

# ============================================
# METRICS CONFIGURATION
# ============================================
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics

# ============================================
# HEALTH CHECK CONFIGURATION
# ============================================
HEALTH_KAFKA_INTERVAL=30
HEALTH_DATABASE_INTERVAL=30
HEALTH_TIMEOUT=5
