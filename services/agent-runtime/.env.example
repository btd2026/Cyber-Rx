# Claude API Configuration
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Database Configuration
DATABASE_URL=postgresql://user:pass@localhost:5432/cyberrx
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Agent Runtime Service
AGENT_RUNTIME_HOST=0.0.0.0
AGENT_RUNTIME_PORT=8000
LOG_LEVEL=INFO

# Cost Tracking
COST_TRACKING_ENABLED=true
COST_ALERT_THRESHOLD=100.0  # Alert if daily cost > $100

# JWT Authentication (from T-FOUND-004)
JWT_SECRET=your-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600

# API Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Claude API Retry Configuration
CLAUDE_MAX_RETRIES=3
CLAUDE_RETRY_DELAY=1.0  # Initial delay in seconds
CLAUDE_RETRY_BACKOFF=2.0  # Exponential backoff multiplier

# Agent Configuration
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=4096
DEFAULT_TIMEOUT=30  # seconds

# Monitoring
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=30  # seconds
