# Risk Normalization Engine - Environment Variables

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_INPUT_TOPIC=raw-security-events
KAFKA_OUTPUT_TOPIC=enriched-risk-objects
KAFKA_CONSUMER_GROUP=normalization-engine
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=true

# TimescaleDB Configuration
TIMESCALEDB_HOST=localhost
TIMESCALEDB_PORT=5432
TIMESCALEDB_DATABASE=cyberrx
TIMESCALEDB_USER=cyberrx
TIMESCALEDB_PASSWORD=your_password_here
TIMESCALEDB_POOL_SIZE=10
TIMESCALEDB_QUERY_TIMEOUT=30

# PHI Stripping Configuration
PHI_STRIPPING_ENABLED=true
PHI_STRIPPING_SPACY_MODEL=en_core_web_sm
PHI_STRIPPING_USE_NLP=true
PHI_STRIPPING_LOG_STRIPPING=true

# Business Process Graph Configuration
BUSINESS_PROCESS_CACHE_TTL_SECONDS=3600
BUSINESS_PROCESS_CACHE_MAX_SIZE=10000

# Blast Radius Configuration
BLAST_RADIUS_MAX_DEPTH=10
BLAST_RADIUS_BFS_TIMEOUT_SECONDS=30

# Regulatory Mapping Configuration
REGULATORY_HIPAA_ENABLED=true
REGULATORY_CMS_ENABLED=true

# Validation Configuration
VALIDATION_STRICT_MODE=true
VALIDATION_WARN_ON_UNKNOWN_FIELDS=true

# Logging Configuration
LOGGING_LEVEL=INFO
LOGGING_FORMAT=json

# Metrics Configuration
METRICS_ENABLED=true
METRICS_PORT=9090

# Health Check Configuration
HEALTH_CHECK_KAFKA_INTERVAL_SECONDS=30
HEALTH_CHECK_DATABASE_INTERVAL_SECONDS=30
HEALTH_CHECK_TIMEOUT_SECONDS=5
