{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cyberrx.com/schemas/events/risk-object-event.json",
  "title": "RiskObjectEvent",
  "description": "RiskObject event published after normalization",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique event identifier (UUID)"
    },
    "risk_object": {
      "type": "object",
      "description": "Normalized RiskObject",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "source": {
          "type": "string"
        },
        "source_event_id": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": ["threat", "vulnerability", "compliance", "vendor", "operational"]
        },
        "affected_assets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "business_process_map": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "likelihood_score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "blast_radius": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "financial_exposure": {
          "type": "object"
        },
        "regulatory_triggers": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "threshold_breaches": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "remediation_owner": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["active", "remediated", "accepted", "escalated"]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "first_detected_at": {
          "type": "string",
          "format": "date-time"
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "methodology_trail": {
          "type": "object"
        },
        "normalization_notes": {
          "type": "string"
        }
      },
      "required": ["id", "source", "source_event_id", "category", "affected_assets", "business_process_map", "likelihood_score", "financial_exposure", "remediation_owner", "status", "created_at", "updated_at", "first_detected_at", "confidence", "methodology_trail"]
    },
    "event_type": {
      "type": "string",
      "enum": ["CREATED", "UPDATED", "REMEDIATED", "ACCEPTED", "ESCALATED"],
      "description": "Type of RiskObject event"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when event occurred"
    },
    "customer_id": {
      "type": "string",
      "description": "Customer identifier for tenant isolation"
    }
  },
  "required": ["event_id", "risk_object", "event_type", "timestamp", "customer_id"],
  "additionalProperties": false
}
