# Test User Credentials
TEST_USER_EMAIL=test@cyberrx.com
TEST_USER_PASSWORD=testpass123

# Security Tool API Keys (for connector testing)
SECURITYSCORECARD_API_KEY=your_securityscorecard_test_key
BITWARDEN_API_KEY=your_bitwarden_test_key
SFTP_PASSWORD=your_test_sftp_password

# Base URL
# Local development: http://localhost:5173
# Staging: https://staging.cyberrx.com
# Production: https://app.cyberrx.com
BASE_URL=http://localhost:5173

# Database (for seed data)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cyberrx_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cyberrx_test

# Redis (for caching/sync jobs)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# API Configuration
API_BASE_URL=http://localhost:3000/api
API_TIMEOUT=30000

# Test Configuration
CI=false
DEBUG=false
HEADLESS=true
RETRIES=2
TIMEOUT=30000

# Feature Flags
ENABLE_MOBILE_TESTS=true
ENABLE_CROSS_BROWSER_TESTS=true
ENABLE_PERFORMANCE_TESTS=true
ENABLE_ACCESSIBILITY_TESTS=false

# Browser Configuration
BROWSER_CHANNEL=chrome  # chrome, msedge, etc.
BROWSER_HEADLESS=true

# Video/Screenshot Configuration
VIDEO=retain-on-failure
SCREENSHOT=only-on-failure
TRACE=on-first-retry

# Parallel Execution
WORKERS=4
FULLY_PARALLEL=true

# Reporting
REPORTER=html,json,junit
REPORT_FOLDER=playwright-report

# Mock Data
MOCK_EXTERNAL_APIS=false
MOCK_SLOW_RESPONSES=false
MOCK_ERRORS=false

# Mobile Device Testing
MOBILE_DEVICES=Pixel 5,iPhone 12
TABLET_DEVICES=iPad Pro 11

# Performance Thresholds
API_RESPONSE_TIME_MS=1000
PAGE_LOAD_TIME_MS=3000
DASHBOARD_RENDER_TIME_MS=2000
