# ============================================================================
# CyberRx API - Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in your values.
# DO NOT commit the actual .env file to version control.
#
# Variable Naming Convention:
# - CRITICAL: Application CANNOT start without these variables
# - REQUIRED: Application starts but logs warnings
# - OPTIONAL: No warnings if not set
#
# For production deployment, use a credential vault (AWS Secrets Manager,
# HashiCorp Vault, or equivalent) instead of environment variables.
# See: CREDENTIAL_VAULT_INTEGRATION.md
# ============================================================================

# ============================================================================
# CRITICAL VARIABLES (Application Cannot Start Without These)
# ============================================================================

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
NODE_ENV=production
# Description: Application runtime environment
# Values: development|production|test
# Required: Yes
# Critical: Yes

# -----------------------------------------------------------------------------
# Server Port
# -----------------------------------------------------------------------------
PORT=3001
# Description: API server listening port
# Values: 1024-65535
# Required: Yes
# Critical: Yes

# -----------------------------------------------------------------------------
# Database Connection
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://cyberrx_user:your_secure_password@localhost:5432/cyberrx
# Description: PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
# Required: Yes
# Critical: Yes
# Example Production: postgresql://user:pass@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Render/Railway: Auto-configured via platform dashboard

# -----------------------------------------------------------------------------
# JWT Authentication Secret
# -----------------------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long
# Description: Secret key for JWT token signing and verification
# Minimum Length: 32 characters
# Required: Yes
# Critical: Yes
# Security: Use cryptographically secure random string in production
# Generate with: openssl rand -base64 32
# Rotation: Change immediately if compromised, rotate periodically (90 days)

# ============================================================================
# REQUIRED VARIABLES (Application Starts With Warnings)
# ============================================================================

# -----------------------------------------------------------------------------
# Session Secret (SSO Flows)
# -----------------------------------------------------------------------------
SESSION_SECRET=change-this-in-production-min-32-chars
# Description: Secret key for Express session encryption (SAML/OIDC flows)
# Minimum Length: 32 characters
# Required: Yes (for SSO functionality)
# Critical: No
# Generate with: openssl rand -base64 32

# ============================================================================
# OPTIONAL VARIABLES - Core Infrastructure
# ============================================================================

# -----------------------------------------------------------------------------
# Credential Vault Mode
# -----------------------------------------------------------------------------
VAULT_MODE=local
# Description: How to load credentials
# Values: local (read from env vars) | aws (AWS Secrets Manager)
# Required: No
# Critical: No

# -----------------------------------------------------------------------------
# Redis Configuration (Rate Limiting, Sessions, Job Queue)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# Description: Redis connection URL for rate limiting, session storage, and BullMQ job queue
# Format: redis://[:password@]host:port/db
# Required: No (required for rate limiting and SSO session persistence)
# Critical: No
# Example Production: redis://default:password@your-redis.render.com:6379

# Alternative Redis configuration (if not using REDIS_URL):
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TLS=false

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
LOG_LEVEL=info
# Description: Logging verbosity level
# Values: debug|info|warn|error
# Required: No
# Critical: No
# Development: debug
# Production: info or warn

# ============================================================================
# OPTIONAL VARIABLES - CORS Configuration
# ============================================================================

# -----------------------------------------------------------------------------
# CORS Allowlist (Production Security)
# -----------------------------------------------------------------------------
CORS_ALLOWLIST=https://app.cyberrx.com,https://www.anthropic.com,https://claude.ai
# Description: Comma-separated list of allowed CORS origins (REQUIRED in production)
# Format: url1,url2,url3
# Required: Yes (in production)
# Critical: No (development has localhost defaults)
# Security: In production mode, ONLY origins in this list can access the API
# Example: https://your-vercel-app.vercel.app,https://custom.domain.com

# FRONTEND_URL=https://app.cyberrx.com
# Description: Single frontend origin (DEPRECATED - use CORS_ALLOWLIST instead)
# Format: url
# Required: No
# Status: Deprecated, kept for backward compatibility

# CORS_REQUIRE_ORIGIN=false
# Description: Require Origin header on all requests (strict mode)
# Values: true|false
# Required: No
# Security: Enable in production to reject requests without Origin header

# ============================================================================
# OPTIONAL VARIABLES - Observability & Monitoring
# ============================================================================

# -----------------------------------------------------------------------------
# Sentry Error Tracking
# -----------------------------------------------------------------------------
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# Description: Sentry Data Source Name for error tracking
# Format: https://...
# Get from: https://sentry.io/settings/projects/
# Required: No
# Critical: No

SENTRY_ENVIRONMENT=production
# Description: Environment tag for Sentry
# Values: development|staging|production
# Required: No
# Critical: No

# -----------------------------------------------------------------------------
# DataDog Monitoring
# -----------------------------------------------------------------------------
DATADOG_API_KEY=your-datadog-api-key
# Description: DataDog API key for metrics and monitoring
# Get from: https://app.datadoghq.com/organization/settings/api-keys
# Required: No
# Critical: No

DATADOG_APP_KEY=your-datadog-app-key
# Description: DataDog application key for dashboards
# Get from: https://app.datadoghq.com/organization/settings/api-keys
# Required: No
# Critical: No

DATADOG_SITE=datadoghq.com
# Description: DataDog site region
# Values: datadoghq.com|us3.datadoghq.com|datadoghq.eu
# Required: No
# Critical: No

DD_ENV=production
# Description: Deployment environment for DataDog
# Required: No
# Critical: No

DD_SERVICE=cyberrx-api
# Description: Service name for DataDog
# Required: No
# Critical: No

DD_VERSION=1.0.0
# Description: Application version for DataDog
# Required: No
# Critical: No

# ============================================================================
# OPTIONAL VARIABLES - Security Tool Credentials (Vendor Integrations)
# ============================================================================
# These are OPTIONAL and only needed if you're using the corresponding tool
# Add only the ones you have credentials for

# -----------------------------------------------------------------------------
# Okta (for MFA % metric)
# -----------------------------------------------------------------------------
# OKTA_DOMAIN=your-org.okta.com
# Description: Okta domain for MFA user statistics
# OKTA_APITOKEN=00your-token-here
# Description: Okta API token (must start with "00")
# Get token from: Okta Admin → API → Tokens

# -----------------------------------------------------------------------------
# CrowdStrike Falcon (for EDR % metric)
# -----------------------------------------------------------------------------
# CROWDSTRIKE_CLIENT_ID=your-client-id
# Description: CrowdStrike Falcon OAuth client ID
# CROWDSTRIKE_CLIENT_SECRET=your-client-secret
# Description: CrowdStrike Falcon OAuth client secret
# Get credentials from: CrowdStrike Falcon Portal → API Clients

# -----------------------------------------------------------------------------
# Splunk (for SIEM retention metric)
# -----------------------------------------------------------------------------
# SPLUNK_HOST=splunk.yourorg.com
# Description: Splunk instance hostname
# SPLUNK_USER=admin
# Description: Splunk API username
# SPLUNK_PASSWORD=your-secure-password
# Description: Splunk API password
# SPLUNK_PORT=8089
# Description: Splunk management port (default: 8089)

# -----------------------------------------------------------------------------
# KnowBe4 (for phishing click rate metric)
# -----------------------------------------------------------------------------
# KNOWBE4_APIKEY=your-api-key
# Description: KnowBe4 API key for phishing campaign metrics
# Get from: KnowBe4 Console → Settings → API

# -----------------------------------------------------------------------------
# Tenable.io (for patch compliance metric)
# -----------------------------------------------------------------------------
# TENABLE_ACCESS_KEY=your-access-key
# Description: Tenable.io API access key
# TENABLE_SECRET_KEY=your-secret-key
# Description: Tenable.io API secret key
# Get from: Tenable.io → User Settings → API Keys

# -----------------------------------------------------------------------------
# SecurityScorecard (for vendor risk monitoring)
# -----------------------------------------------------------------------------
# SECURITYSCORECARD_APIKEY=your-api-key-here
# Description: SecurityScorecard API key for vendor ratings
# Get from: https://securityscorecard.com/api-management

# ============================================================================
# OPTIONAL VARIABLES - ITSM Systems (Ticket Integration)
# ============================================================================
# These are OPTIONAL - add only the ITSM system your organization uses

# -----------------------------------------------------------------------------
# ServiceNow (Recommended for BCBS demos)
# -----------------------------------------------------------------------------
# SNOW_INSTANCE=dev12345
# Description: ServiceNow instance name
# SNOW_USER=admin
# Description: ServiceNow API username
# SNOW_PASSWORD=your-password
# Description: ServiceNow API password
# SNOW_ASSIGN_GROUP=IT Security
# Description: Default assignment group for security tickets

# -----------------------------------------------------------------------------
# Jira
# -----------------------------------------------------------------------------
# JIRA_INSTANCE=yourorg
# Description: Jira instance name (subdomain)
# JIRA_EMAIL=you@yourorg.com
# Description: Jira API email
# JIRA_TOKEN=your-api-token
# Description: Jira API token (get from Atlassian account settings)
# JIRA_PROJECT=SEC
# Description: Jira project key for security tickets

# -----------------------------------------------------------------------------
# Freshservice
# -----------------------------------------------------------------------------
# FRESHSERVICE_DOMAIN=yourorg
# Description: Freshservice domain
# FRESHSERVICE_APIKEY=your-api-key
# Description: Freshservice API key

# ============================================================================
# OPTIONAL VARIABLES - SSO Configuration (Single Sign-On)
# ============================================================================

# -----------------------------------------------------------------------------
# SAML Configuration (Okta SSO)
# -----------------------------------------------------------------------------
# SAML_ENTRY_POINT=https://dev-123456.okta.com/app/dev123456/sso/saml
# Description: Okta SAML SSO entry point URL
# SAML_ISSUER=https://dev-123456.okta.com
# Description: Okta SAML issuer URI
# SAML_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# Description: Okta X.509 certificate in PEM format
# SAML_CALLBACK_URL=http://localhost:3001/sso/saml/callback
# Description: SAML assertion consumer service (ACS) URL

# -----------------------------------------------------------------------------
# Azure AD OIDC Configuration
# -----------------------------------------------------------------------------
# AZURE_AD_CLIENT_ID=your-client-id
# Description: Azure AD application (client) ID
# AZURE_AD_CLIENT_SECRET=your-client-secret
# Description: Azure AD application client secret
# AZURE_AD_TENANT_ID=contoso.onmicrosoft.com
# Description: Azure AD tenant ID (domain or GUID)
# AZURE_AD_CALLBACK_URL=http://localhost:3001/sso/azure/callback
# Description: Azure AD redirect URI

# -----------------------------------------------------------------------------
# SSO User Provisioning
# -----------------------------------------------------------------------------
# DEFAULT_SSO_ORG_ID=default-org
# Description: Default organization ID for auto-provisioned SSO users
# Security: Create a dedicated org for SSO users in production

# ============================================================================
# OPTIONAL VARIABLES - Rate Limiting
# ============================================================================

# RATE_LIMIT_ENABLED=true
# Description: Enable/disable API rate limiting
# Values: true|false
# Default: true

# RATE_LIMIT_WINDOW=60
# Description: Rate limit time window in seconds
# Default: 60

# ============================================================================
# DEPLOYMENT NOTES
# ============================================================================

# Development (Local):
# - Copy this file to .env
# - Set NODE_ENV=development
# - Use localhost URLs for DATABASE_URL and REDIS_URL
# - Generate local secrets with openssl rand -base64 32

# Production (Vercel/Railway/Render):
# - Use platform environment variable dashboard (not .env file)
# - Set NODE_ENV=production
# - Set CORS_ALLOWLIST to your production frontend URLs
# - Use production database connection string
# - Generate production secrets with cryptographic RNG
# - Enable SENTRY_DSN for error tracking
# - Enable DATADOG_API_KEY for monitoring

# Security Best Practices:
# 1. NEVER commit .env file to version control
# 2. Use credential vault in production (AWS Secrets Manager, HashiCorp Vault)
# 3. Rotate JWT_SECRET and SESSION_SECRET periodically (90 days)
# 4. Use different secrets for each environment (dev/staging/prod)
# 5. Monitor for leaked secrets with git-secrets or truffleHog
# 6. Enable CORS_ALLOWLIST in production with explicit origins
# 7. Use strong, unique passwords for database and Redis
# 8. Enable rate limiting to prevent abuse

# See CREDENTIAL_VAULT_INTEGRATION.md for production deployment with vaults.
