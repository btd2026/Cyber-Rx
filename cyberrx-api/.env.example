# CyberRx API — Environment Variables for Render Deployment
# Copy this file to .env and fill in your values

# Render Auto-Configured Database Variables
# These are automatically set by Render when you link the database
# DATABASE_URL=postgresql://user:password@host:port/database
# PGHOST=database-host
# PGPORT=5432
# PGDATABASE=cyberrx
# PGUSER=cyberrx_user
# PGPASSWORD=your-password

# Vault mode: "local" reads from env vars below, "aws" uses Secrets Manager
VAULT_MODE=local

# JWT secret (change this in production)
JWT_SECRET=change-this-in-production-min-32-chars

NODE_ENV=production
PORT=3001

# CORS Configuration
# Option 1: Use CORS_ALLOWLIST (recommended for production) - comma-separated list of allowed origins
CORS_ALLOWLIST=https://your-vercel-app.vercel.app,https://www.anthropic.com,https://claude.ai
# Option 2: Use FRONTEND_URL as single origin (fallback if CORS_ALLOWLIST not set)
# FRONTEND_URL=https://your-vercel-app.vercel.app

# ── Security Tool Credentials (add the ones you have) ──────────────────────

# Okta (for MFA % metric)
# OKTA_DOMAIN=your-org.okta.com
# OKTA_APITOKEN=00your-token-here

# CrowdStrike Falcon (for EDR % metric)
# CROWDSTRIKE_CLIENT_ID=your-client-id
# CROWDSTRIKE_CLIENT_SECRET=your-client-secret

# Splunk (for SIEM retention metric)
# SPLUNK_HOST=splunk.yourorg.com
# SPLUNK_USER=admin
# SPLUNK_PASSWORD=your-password
# SPLUNK_PORT=8089

# KnowBe4 (for phishing click rate metric)
# KNOWBE4_APIKEY=your-api-key

# Tenable.io (for patch compliance metric)
# TENABLE_ACCESS_KEY=your-access-key
# TENABLE_SECRET_KEY=your-secret-key

# ── ITSM Systems (add the one your org uses) ────────────────────────────────

# ServiceNow (recommended for BCBS demo)
# SNOW_INSTANCE=dev12345
# SNOW_USER=admin
# SNOW_PASSWORD=your-password
# SNOW_ASSIGN_GROUP=IT Security

# Jira
# JIRA_INSTANCE=yourorg
# JIRA_EMAIL=you@yourorg.com
# JIRA_TOKEN=your-api-token
# JIRA_PROJECT=SEC

# Freshservice
# FRESHSERVICE_DOMAIN=yourorg
# FRESHSERVICE_APIKEY=your-api-key

# ── AWS (only needed for production deployment) ─────────────────────────────
# AWS_REGION=us-east-1
