# CyberRx API — Environment Variables for Render Deployment
# Copy this file to .env and fill in your values

# Render Auto-Configured Database Variables
# These are automatically set by Render when you link the database
# DATABASE_URL=postgresql://user:password@host:port/database
# PGHOST=database-host
# PGPORT=5432
# PGDATABASE=cyberrx
# PGUSER=cyberrx_user
# PGPASSWORD=your-password

# Vault mode: "local" reads from env vars below, "aws" uses Secrets Manager
VAULT_MODE=local

# JWT secret (change this in production)
JWT_SECRET=change-this-in-production-min-32-chars

NODE_ENV=production
PORT=3001

# CORS Configuration
# Option 1: Use CORS_ALLOWLIST (recommended for production) - comma-separated list of allowed origins
CORS_ALLOWLIST=https://your-vercel-app.vercel.app,https://www.anthropic.com,https://claude.ai
# Option 2: Use FRONTEND_URL as single origin (fallback if CORS_ALLOWLIST not set)
# FRONTEND_URL=https://your-vercel-app.vercel.app

# ── Security Tool Credentials (add the ones you have) ──────────────────────

# Okta (for MFA % metric)
# OKTA_DOMAIN=your-org.okta.com
# OKTA_APITOKEN=00your-token-here

# CrowdStrike Falcon (for EDR % metric)
# CROWDSTRIKE_CLIENT_ID=your-client-id
# CROWDSTRIKE_CLIENT_SECRET=your-client-secret

# Splunk (for SIEM retention metric)
# SPLUNK_HOST=splunk.yourorg.com
# SPLUNK_USER=admin
# SPLUNK_PASSWORD=your-password
# SPLUNK_PORT=8089

# KnowBe4 (for phishing click rate metric)
# KNOWBE4_APIKEY=your-api-key

# Tenable.io (for patch compliance metric)
# TENABLE_ACCESS_KEY=your-access-key
# TENABLE_SECRET_KEY=your-secret-key

# SecurityScorecard (for vendor risk monitoring)
# Get API key from: https://securityscorecard.com/api-management
# SECURITYSCORECARD_APIKEY=your-api-key-here

# ── ITSM Systems (add the one your org uses) ────────────────────────────────

# ServiceNow (recommended for BCBS demo)
# SNOW_INSTANCE=dev12345
# SNOW_USER=admin
# SNOW_PASSWORD=your-password
# SNOW_ASSIGN_GROUP=IT Security

# Jira
# JIRA_INSTANCE=yourorg
# JIRA_EMAIL=you@yourorg.com
# JIRA_TOKEN=your-api-token
# JIRA_PROJECT=SEC

# Freshservice
# FRESHSERVICE_DOMAIN=yourorg
# FRESHSERVICE_APIKEY=your-api-key

# ── AWS (only needed for production deployment) ─────────────────────────────
# AWS_REGION=us-east-1

# ============================================================================
# EXECUTIVE AI AGENT LAYER
# ============================================================================
# Powers the continuous, role-specific executive briefs (CFO, CRO, CLO, CIO,
# CISO, Board). When ANTHROPIC_API_KEY is set, briefs are synthesized by Claude.
# When it is not set, the agent layer falls back to a deterministic synthesis
# computed from the same primary-source data, so the feature always works.
# Get a key from https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8
# How often the agents re-read the stack and refresh briefs (cron expression).
# BRIEF_REFRESH_CRON=*/15 * * * *

# ============================================================================
# OBSERVABILITY & MONITORING CONFIGURATION
# ============================================================================

# ── Sentry Error Tracking ─────────────────────────────────────────────────────
# Get your DSN from https://sentry.io/settings/projects/
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# SENTRY_ENVIRONMENT=production

# ── DataDog Monitoring ───────────────────────────────────────────────────────
# Get your keys from https://app.datadoghq.com/organization/settings/api-keys
# DATADOG_API_KEY=your-datadog-api-key
# DATADOG_APP_KEY=your-datadog-app-key
# DATADOG_SITE=datadoghq.com
# DD_ENV=production
# DD_SERVICE=cyberrx-api
# DD_VERSION=1.0.0

# ── Logging Configuration ─────────────────────────────────────────────────────
# Options: debug, info, warn, error
# LOG_LEVEL=info

# ============================================================================
# SSO CONFIGURATION (Single Sign-On for Enterprise Authentication)
# ============================================================================

# ── SAML Configuration (Okta SSO) ─────────────────────────────────────────────
# Okta SAML SSO Entry Point URL
# Example: https://dev-123456.okta.com/app/dev123456/sso/saml
# SAML_ENTRY_POINT=

# Okta SAML Issuer URI
# Example: https://dev-123456.okta.com
# SAML_ISSUER=

# Okta X.509 Certificate (PEM format)
# Get this from your Okta application settings
# SAML_CERT=

# SAML Callback URL
# Example: https://api.cyberrx.com/sso/saml/callback
# SAML_CALLBACK_URL=http://localhost:3001/sso/saml/callback

# ── Azure AD OIDC Configuration ─────────────────────────────────────────────────
# Azure AD Application (Client) ID
# AZURE_AD_CLIENT_ID=

# Azure AD Application (Client) Secret
# AZURE_AD_CLIENT_SECRET=

# Azure AD Tenant ID
# Example: contoso.onmicrosoft.com or tenant GUID
# AZURE_AD_TENANT_ID=

# Azure AD Callback URL
# Example: https://api.cyberrx.com/sso/azure/callback
# AZURE_AD_CALLBACK_URL=http://localhost:3001/sso/azure/callback

# ── SSO User Provisioning ───────────────────────────────────────────────────────
# Default organization ID for auto-provisioned SSO users
DEFAULT_SSO_ORG_ID=default-org

# ── Session Configuration (for SSO flows) ───────────────────────────────────────
# Session secret for Express session (use strong random string in production)
SESSION_SECRET=change-this-in-production-min-32-chars

# ── Redis Configuration (for SSO session storage and BullMQ job queue) ───────────
# Redis connection URL (for rate limiting, session storage, and job queue)
# Format: redis://[:password@]host:port/db
# REDIS_URL=redis://localhost:6379

# Alternative Redis configuration (if not using REDIS_URL)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TLS=false

# ── BullMQ Job Queue Configuration (Vendor Sync Operations) ─────────────────────
# BullMQ uses the same Redis connection as above for job queue processing
# Queue Name: vendor-sync-queue (hardcoded in workers/queue.js)
# Job Types: sync_vendor, sync_connector, assessment
# Max Retries: 5 (with exponential backoff: 1s, 5s, 30s, 2m, 6m)
# Job Retention: Completed and failed jobs are kept for audit/debugging
#
# For production Redis (Render, Upstash, etc.):
# - Render Redis: Use internal Redis URL provided by Render
# - Upstash: Use REST URL with ioredis REST adapter
# - AWS ElastiCache: Use endpoint with TLS enabled
#
# Example production REDIS_URL:
# REDIS_URL=redis://default:password@your-redis.render.com:6379

# ── Rate Limiting Configuration ───────────────────────────────────────────────────
# Enable/disable rate limiting (default: true)
# RATE_LIMIT_ENABLED=true

# Rate limit window in seconds (default: 60)
# RATE_LIMIT_WINDOW=60
