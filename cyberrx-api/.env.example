# Nerion API — Environment Variables for Render Deployment
# Copy this file to .env and fill in your values

# Render Auto-Configured Database Variables
# These are automatically set by Render when you link the database
# DATABASE_URL=postgresql://user:password@host:port/database
# PGHOST=database-host
# PGPORT=5432
# PGDATABASE=cyberrx
# PGUSER=cyberrx_user
# PGPASSWORD=your-password

# Vault mode: "local" reads from env vars below, "aws" uses Secrets Manager
VAULT_MODE=local

# JWT secret (change this in production)
JWT_SECRET=change-this-in-production-min-32-chars

NODE_ENV=production
PORT=3001

# CORS Configuration
# Option 1: Use CORS_ALLOWLIST (recommended for production) - comma-separated list of allowed origins
CORS_ALLOWLIST=https://your-vercel-app.vercel.app,https://www.anthropic.com,https://claude.ai
# Option 2: Use FRONTEND_URL as single origin (fallback if CORS_ALLOWLIST not set)
# FRONTEND_URL=https://your-vercel-app.vercel.app

# ── Security Tool Credentials (add the ones you have) ──────────────────────

# Okta (for MFA % metric)
# OKTA_DOMAIN=your-org.okta.com
# OKTA_APITOKEN=00your-token-here

# CrowdStrike Falcon (for EDR % metric)
# CROWDSTRIKE_CLIENT_ID=your-client-id
# CROWDSTRIKE_CLIENT_SECRET=your-client-secret

# Splunk (for SIEM retention metric)
# SPLUNK_HOST=splunk.yourorg.com
# SPLUNK_USER=admin
# SPLUNK_PASSWORD=your-password
# SPLUNK_PORT=8089

# KnowBe4 (for phishing click rate metric)
# KNOWBE4_APIKEY=your-api-key

# Tenable.io (for patch compliance metric)
# TENABLE_ACCESS_KEY=your-access-key
# TENABLE_SECRET_KEY=your-secret-key

# SecurityScorecard (for vendor risk monitoring)
# Get API key from: https://securityscorecard.com/api-management
# SECURITYSCORECARD_APIKEY=your-api-key-here

# ── ITSM Systems (add the one your org uses) ────────────────────────────────

# ServiceNow (recommended for BCBS demo)
# SNOW_INSTANCE=dev12345
# SNOW_USER=admin
# SNOW_PASSWORD=your-password
# SNOW_ASSIGN_GROUP=IT Security

# Jira
# JIRA_INSTANCE=yourorg
# JIRA_EMAIL=you@yourorg.com
# JIRA_TOKEN=your-api-token
# JIRA_PROJECT=SEC

# Freshservice
# FRESHSERVICE_DOMAIN=yourorg
# FRESHSERVICE_APIKEY=your-api-key

# ── AWS (only needed for production deployment) ─────────────────────────────
# AWS_REGION=us-east-1

# ============================================================================
# EXECUTIVE AI AGENT LAYER
# ============================================================================
# Powers the continuous, role-specific executive briefs (CFO, CRO, CLO, CIO,
# CISO, Board). When ANTHROPIC_API_KEY is set, briefs are synthesized by Claude.
# When it is not set, the agent layer falls back to a deterministic synthesis
# computed from the same primary-source data, so the feature always works.
# Get a key from https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8
# Model for the intake-driven executive summary (low temperature, JSON output).
# Falls back to a grounded deterministic summary when ANTHROPIC_API_KEY is unset.
# ANTHROPIC_SUMMARY_MODEL=claude-opus-4-8
# Model for per-control document review in the intake pipeline.
# ANTHROPIC_REVIEW_MODEL=claude-haiku-4-5-20251001

# ============================================================================
# CISO reminder emails (Decisions & projections tab)
# ============================================================================
# The CISO cockpit can email a leader a reminder about the cyber decisions they
# still owe. The email BODY is drafted by an LLM; SENDING uses SMTP.
#
# Drafting engine (NOTIFY_DRAFT_ENGINE = auto | cloud | local | template):
#   auto (default) → Anthropic cloud if ANTHROPIC_API_KEY, else the internal
#   local LLM if LOCAL_LLM_URL, else a deterministic template (always works).
# NOTIFY_DRAFT_ENGINE=auto
# NOTIFY_DRAFT_MODEL=claude-opus-4-8
# Internal/offline LLM endpoint (OpenAI-compatible /chat/completions, e.g. Ollama):
# LOCAL_LLM_URL=http://localhost:11434/v1/chat/completions
# LOCAL_LLM_MODEL=llama3.1
#
# Sending — SMTP. Set these to send server-side; if unset, the cockpit opens the
# draft in the sender's own mail client (mailto) so the feature still works.
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_SECURE=false                 # true for port 465
# SMTP_USER=apikey-or-username
# SMTP_PASS=your-smtp-password
# SMTP_FROM=Nerion <no-reply@yourcompany.com>

# --- Scan quota (hard cost ceiling, spec §3b) ---
# Every user/org is limited to N assessment scans per window. The gate runs
# before any embedding/LLM/batch work. Defaults below apply in EVERY environment;
# raise SCAN_QUOTA_LIMIT for local load testing only. There is no silent bypass —
# SCAN_QUOTA_ENABLED=false is for narrow test setup, not production.
# SCAN_QUOTA_LIMIT=2
# SCAN_QUOTA_WINDOW=calendar_month        # or: rolling_30d
# SCAN_QUOTA_SCOPE=org                     # or: user, account
# SCAN_QUOTA_ENABLED=true

# --- Retrieval / embeddings (Stage 3) ---
# Voyage AI embeddings (provider-swappable) + pgvector store. Without a key,
# documents are still chunked & stored; only vector retrieval is disabled.
# VOYAGE_API_KEY=
# EMBEDDING_PROVIDER=voyage
# VOYAGE_MODEL=voyage-3
# EMBED_DIM=1024                  # must match the vector(N) column dimension
# EMBED_BATCH_SIZE=96
# CHUNK_MAX_CHARS=1800
# CHUNK_MIN_CHARS=120
# RETRIEVAL_TOP_K=5
# RETRIEVAL_SIM_THRESHOLD=0.55    # below this, a control is "Not addressed" with no LLM call (Stage 4)

# --- Grounded assessment models (Stage 4; routing in Stage 5) ---
# Model IDs are config. Current generation: Haiku 4.5 / Sonnet 4.6 / Opus 4.8.
# ASSESSMENT_JUDGE_MODEL=claude-sonnet-4-6
# ASSESSMENT_TRIAGE_MODEL=claude-haiku-4-5-20251001
# ASSESSMENT_ESCALATE_MODEL=claude-opus-4-8
# ASSESSMENT_MAX_TOKENS=1024
# Stage 5 routing + verification + cost telemetry:
# ASSESSMENT_OBVIOUS_SIM=0.82        # >= this retrieval similarity -> cheap model
# ASSESSMENT_ESCALATE_BELOW=0.6      # verdict confidence < this -> re-judge with flagship
# ASSESSMENT_VERIFY=true             # asymmetric verification of positive verdicts
# PRICING_JSON={"claude-opus-4-8":{"input":15,"output":75,"cached_read":1.5}}  # cost-estimate overrides

# --- Crown-Jewels analysis run cost ceiling (spec §3b) ---
# Full graph rebuilds consume from the cap; incremental deltas are uncapped by
# default (set ANALYSIS_DELTA_CAPPED=true to count them). No silent bypass.
# ANALYSIS_FULL_REBUILD_CAP=5
# ANALYSIS_WINDOW=calendar_month        # or rolling_30d
# ANALYSIS_SCOPE=account                # or org, user
# ANALYSIS_DELTA_CAPPED=false
# ANALYSIS_ENABLED=true
# PILOT/TEST: when true, the intake checklist exposes a "Use sample (test)"
# action that generates a representative document per control so the full
# pipeline can run end-to-end. Samples are clearly labeled test fixtures.
# PILOT_SAMPLE_DOCS=false
# Phase 7 scaffold: anonymized cross-tenant benchmarking (consent-bounded,
# k-anonymity). All /api/benchmark endpoints 404 unless this is true.
# CROSS_TENANT_BENCHMARKING=false
# How often the agents re-read the stack and refresh briefs (cron expression).
# BRIEF_REFRESH_CRON=*/15 * * * *
# Admin override for the simulated live-source data API (/api/sources).
# Requests with header X-Admin-Key matching this value (or a JWT with role
# 'admin') can view and sync EVERY org's source data; orgs otherwise only see
# their own. Set a strong random value.
# ADMIN_API_KEY=change-me
# Load the executive-brief demo dataset on startup (idempotent). Set to true
# once to populate Blue Cross Blue Shield of Massachusetts demo data, then the
# briefs render real dollar-quantified numbers. Also runnable via `npm run seed:demo`.
# SEED_DEMO_DATA=false
# SEED_DEMO_FORCE=false   # re-run the SQL even if the org already has data

# ============================================================================
# OBSERVABILITY & MONITORING CONFIGURATION
# ============================================================================

# ── Sentry Error Tracking ─────────────────────────────────────────────────────
# Get your DSN from https://sentry.io/settings/projects/
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# SENTRY_ENVIRONMENT=production

# ── DataDog Monitoring ───────────────────────────────────────────────────────
# Get your keys from https://app.datadoghq.com/organization/settings/api-keys
# DATADOG_API_KEY=your-datadog-api-key
# DATADOG_APP_KEY=your-datadog-app-key
# DATADOG_SITE=datadoghq.com
# DD_ENV=production
# DD_SERVICE=cyberrx-api
# DD_VERSION=1.0.0

# ── Logging Configuration ─────────────────────────────────────────────────────
# Options: debug, info, warn, error
# LOG_LEVEL=info

# ============================================================================
# SSO CONFIGURATION (Single Sign-On for Enterprise Authentication)
# ============================================================================

# ── SAML Configuration (Okta SSO) ─────────────────────────────────────────────
# Okta SAML SSO Entry Point URL
# Example: https://dev-123456.okta.com/app/dev123456/sso/saml
# SAML_ENTRY_POINT=

# Okta SAML Issuer URI
# Example: https://dev-123456.okta.com
# SAML_ISSUER=

# Okta X.509 Certificate (PEM format)
# Get this from your Okta application settings
# SAML_CERT=

# SAML Callback URL
# Example: https://api.cyberrx.com/sso/saml/callback
# SAML_CALLBACK_URL=http://localhost:3001/sso/saml/callback

# ── Azure AD OIDC Configuration ─────────────────────────────────────────────────
# Azure AD Application (Client) ID
# AZURE_AD_CLIENT_ID=

# Azure AD Application (Client) Secret
# AZURE_AD_CLIENT_SECRET=

# Azure AD Tenant ID
# Example: contoso.onmicrosoft.com or tenant GUID
# AZURE_AD_TENANT_ID=

# Azure AD Callback URL
# Example: https://api.cyberrx.com/sso/azure/callback
# AZURE_AD_CALLBACK_URL=http://localhost:3001/sso/azure/callback

# ── SSO User Provisioning ───────────────────────────────────────────────────────
# Default organization ID for auto-provisioned SSO users
DEFAULT_SSO_ORG_ID=default-org

# ── Session Configuration (for SSO flows) ───────────────────────────────────────
# Session secret for Express session (use strong random string in production)
SESSION_SECRET=change-this-in-production-min-32-chars

# ── Redis Configuration (for SSO session storage and BullMQ job queue) ───────────
# Redis connection URL (for rate limiting, session storage, and job queue)
# Format: redis://[:password@]host:port/db
# REDIS_URL=redis://localhost:6379

# Alternative Redis configuration (if not using REDIS_URL)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TLS=false

# ── BullMQ Job Queue Configuration (Vendor Sync Operations) ─────────────────────
# BullMQ uses the same Redis connection as above for job queue processing
# Queue Name: vendor-sync-queue (hardcoded in workers/queue.js)
# Job Types: sync_vendor, sync_connector, assessment
# Max Retries: 5 (with exponential backoff: 1s, 5s, 30s, 2m, 6m)
# Job Retention: Completed and failed jobs are kept for audit/debugging
#
# For production Redis (Render, Upstash, etc.):
# - Render Redis: Use internal Redis URL provided by Render
# - Upstash: Use REST URL with ioredis REST adapter
# - AWS ElastiCache: Use endpoint with TLS enabled
#
# Example production REDIS_URL:
# REDIS_URL=redis://default:password@your-redis.render.com:6379

# ── Rate Limiting Configuration ───────────────────────────────────────────────────
# Enable/disable rate limiting (default: true)
# RATE_LIMIT_ENABLED=true

# Rate limit window in seconds (default: 60)
# RATE_LIMIT_WINDOW=60
