{
  "name": "cyberrx-api",
  "version": "1.0.0",
  "description": "CyberRx backend API proxy — ITSM routing, security tool sync, credentials vault",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "scheduler": "node src/scheduler.js",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:health": "curl -s http://localhost:3001/health | node -e \"process.stdin.resume();process.stdin.setEncoding('utf8');process.stdin.on('data',d=>{const j=JSON.parse(d);console.log('Status:',j.status,'Version:',j.version);})\""
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.600.0",
    "@sentry/node": "^10.55.0",
    "axios": "^1.16.1",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.29.0",
    "connect-redis": "^9.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "express-session": "^1.19.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "openid-client": "^6.8.4",
    "passport": "^0.7.0",
    "passport-azure-oidc": "^1.0.2",
    "passport-saml": "^3.2.4",
    "pg": "^8.11.0",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^11.1.0",
    "redis": "^6.0.0",
    "serverless-http": "^3.2.0",
    "speakeasy": "^2.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.0",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
