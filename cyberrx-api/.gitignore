# Nerion Backend .gitignore

# Environment
.env
.env.*
!.env.example

# Dependencies
node_modules/
npm-debug.log*
yarn-error.log*

# Build
dist/
build/

# Testing
coverage/
*.lcov
test-results/

# Logs
logs/
*.log

# Temporary
tmp/
.cache/

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# License (appliance) — vendor artifacts, never commit
config/license_priv.pem
config/license_pub.pem
config/license.json
config/.license_state.json
# Tamper seal (appliance) — build/runtime artifacts, never commit
config/integrity.manifest
config/.sealed
config/.vault_key
config/unseal.json
